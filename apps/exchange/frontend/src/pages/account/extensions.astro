---
import Account from "../../layouts/Account.astro";
import DashboardDrawing from "../../components/DashboardDrawing.astro";
import "../../styles/submission-studio.css";
---
<Account title="Your" titleAccent="submissions." section="extensions">
  <div class="submission-studio">
    <section class="submission-records" aria-labelledby="release-desk-title"><header class="submission-records-heading"><h2 id="release-desk-title">Recent versions</h2><div class="actions"><button class="button secondary" id="submissions-refresh" type="button">Refresh status</button><a class="button" href="/publish">Submit a package <span aria-hidden="true">↗</span></a></div></header>
      <div class="submission-find"><div class="submission-filters" role="group" aria-label="Filter submissions by status"><button type="button" data-submission-filter="all" aria-pressed="true">All <span data-submission-count="all">0</span></button><button type="button" data-submission-filter="progress" aria-pressed="false">In progress <span data-submission-count="progress">0</span></button><button type="button" data-submission-filter="attention" aria-pressed="false">Needs attention <span data-submission-count="attention">0</span></button><button type="button" data-submission-filter="published" aria-pressed="false">Published <span data-submission-count="published">0</span></button></div><div class="submission-search"><label for="submission-search">Find a version</label><input id="submission-search" type="search" placeholder="Search name, publisher or version" autocomplete="off" /></div></div>
      <p id="submissions-count" class="submission-feedback" title="Shows up to 100 most recent submissions" role="status" aria-live="polite">Loading your submissions…</p><ul id="account-submissions" aria-label="Your submitted versions" aria-busy="true"></ul>
    </section>
    <details class="submission-guide"><summary>How does a package become available in Tabs?</summary><div class="submission-guide-content"><DashboardDrawing section="extensions" /><ol><li><strong>Send your package</strong><p>Choose the publisher and upload one built archive. Each version has its own record.</p></li><li><strong>Checks and review</strong><p>The registry scans the package, then a reviewer records a decision. Feedback appears in its details.</p></li><li><strong>A signed release</strong><p>An approved version becomes available after signed publication. Approval and publication are separate steps.</p></li></ol></div><a href="/docs/extensions/publishing">Read the publishing guide ↗</a></details>
  </div>
</Account>
<script>import "../../scripts/submissions";</script>
