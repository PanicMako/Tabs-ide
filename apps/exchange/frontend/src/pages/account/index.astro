---
import Account from "../../layouts/Account.astro";
---
<Account title="Your" titleAccent="workbench" section="overview">
  <div class="workbench-intro"><p id="account-identity"></p><a class="text-link" href="/account/namespaces">Manage your publisher identity ↗</a></div>
  <section class="workbench-launch" aria-labelledby="workbench-launch-title">
    <div class="workbench-caption"><h2 id="workbench-launch-title">Publisher shortcuts</h2><span aria-hidden="true">↙</span></div>
    <div class="workbench-tabs"><a href="/developers"><span class="workbench-dot" aria-hidden="true"></span>Build a tool ↗</a><a href="/publish"><span class="workbench-dot" aria-hidden="true"></span>Submit a package ↗</a><a href="/account/extensions"><span class="workbench-dot" aria-hidden="true"></span>Follow a release ↗</a></div>
    <div class="workbench-sheet workbench-record"><section class="overview-releases" aria-labelledby="release-desk-title"><div class="section-heading"><div><p class="step-label">Your release record</p><h2 id="release-desk-title">Recent versions</h2></div><button class="button secondary" id="submissions-refresh" type="button">Refresh</button></div><p id="submissions-count" role="status" aria-live="polite">Loading submissions…</p><ul id="account-submissions"></ul><a class="text-link" href="/account/extensions">All submissions ↗</a></section></div>
  </section>
  <p class="notice" id="publishing-availability"></p>
  <section class="publisher-ledger account-namespace-panel" aria-labelledby="your-namespaces-title"><div><span class="eyebrow">Your publishing identity</span><h2 id="your-namespaces-title">Your namespaces</h2><ul id="account-namespaces"></ul></div><a class="text-link" href="/account/namespaces">Manage namespaces ↗</a></section>
</Account>
<script>import "../../scripts/agreement"; import "../../scripts/submissions";</script>
