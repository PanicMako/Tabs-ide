---
import Operations from "../../layouts/Operations.astro";
import DashboardDrawing from "../../components/DashboardDrawing.astro";
import WorkspaceControls from "../../components/WorkspaceControls.astro";
---
<Operations title="Review desk." accent="One package at a time." description="See what’s ready, inspect the evidence, and leave a clear decision for the publisher." section="review">
  <div class="review-session"><p id="review-status" tabindex="-1" class="operations-status" role="status" aria-live="polite">Checking reviewer access…</p>
  <button class="button secondary" id="review-refresh" type="button">Refresh queue</button>
  <a id="review-signin" href="/auth/github/start?returnTo=%2Fadmin" hidden>Sign in with GitHub</a></div>
  <section id="review-content" data-workspace-panels class="review-control-room" hidden aria-label="Pending package reviews">
    <div class="review-overview" aria-label="Loaded review queue"><div><span class="desk-kicker">YOUR QUEUE</span><h2>Your review queue</h2><p>Choose a package below to get started.</p></div><dl class="review-counts"><div><dt>Ready for review</dt><dd id="review-ready-count">—</dd></div><div><dt>Waiting for a scan</dt><dd id="review-scanning-count">—</dd></div><div><dt>Approved versions</dt><dd id="review-approved-count">—</dd></div></dl></div>

<WorkspaceControls label="Review desk tasks" entries={[["review-inbox", "Packages", "Choose what to review"], ["review-health-panel", "Service health", "Scanner and signing status"], ["review-history-panel", "History", "Find a release"], ["review-appeals-panel", "Appeals", "Read publisher responses"]]} />
    <section id="review-inbox" data-workspace-panel class="review-inbox" aria-labelledby="review-inbox-title"><div class="section-heading"><div><p class="step-label">PACKAGE QUEUE</p><h2 id="review-inbox-title">Choose a package</h2></div><a href="#review-history-heading">Look up release history ↗</a></div><div class="review-search-bar"><div><div class="form-field"><label for="review-query">Find a package</label><input id="review-query" type="search" placeholder="Search publisher, extension or version…" autocomplete="off" /></div></div><div><div class="form-field"><label for="review-scope">Show</label><select id="review-scope"><option value="all">All packages</option><option value="pending">Pending review</option><option value="approved">Approved versions</option></select></div></div></div><p id="review-filter-status" role="status" aria-live="polite">Search applies to packages loaded in this queue.</p><ul id="review-items"></ul>    <details class="review-guidance"><summary>How review and signed publication work</summary><p>The first 100 pending submissions are shown oldest first, followed by up to 100 recently approved releases. Approval requires a passing scan for the exact digest. Approval does not guarantee safety or publish a release.</p>
    <p>Signing remains an operator workflow outside the browser. After approval or revocation, publish updated TUF metadata using the documented operator procedure. Never upload signing keys here.</p>
    <a href="/docs/extensions/self-hosting">Operator and signing documentation</a></details></section>

    <section id="review-health-panel" data-workspace-panel class="operations-panel service-panel" aria-labelledby="review-operations-heading">
      <div class="service-heading"><div><p class="step-label">SERVICE HEALTH</p><h2 id="review-operations-heading">Keep things moving.</h2><p>See the scanner, signing status, and anything that needs your attention.</p></div><DashboardDrawing section="review-health-panel" compact /></div>
      <div class="review-health-strip"><p id="review-health-indicator" role="status">Checking registry health…</p><a href="/docs/extensions/self-hosting">Operator &amp; signing guide ↗</a></div>
      <details class="service-context"><summary>About this health snapshot</summary><p id="review-operations" role="status" aria-live="polite">Operational status has not been loaded.</p><p>This is server-reported status, not independent verification of signatures or confirmation that every installed client received a revocation.</p></details>
      <div id="review-operations-details" hidden>
        <div id="review-health-metrics" class="health-metrics" aria-label="Registry activity"></div><p id="review-health-pipeline" class="health-pipeline"></p>
        <div class="service-section-heading"><div><p class="step-label">START HERE</p><h3>What needs attention</h3></div><span>From the latest server snapshot</span></div>
        <ul id="review-operations-alerts" class="health-alerts"></ul>
        <div class="service-section-heading"><div><h3>Signing metadata</h3><p>Four roles keep the published registry up to date.</p></div><a href="/docs/extensions/self-hosting">How signing works ↗</a></div>
        <ul id="review-operations-metadata" class="health-roles"></ul><p class="service-footnote">Expiry is advisory; signatures are not verified here. Missing, invalid, or expired roles need operator attention. Refresh expiring roles before their expiry.</p>
        <div class="service-section-heading"><div><h3>Recent activity</h3><p>Last recorded events, shown in UTC.</p></div></div><ul id="review-operations-activity" class="health-events"></ul>
        <details id="review-revocations-fold" class="service-fold"><summary>Revocations awaiting signed publication</summary><p>These identities remain in published targets despite a recorded review revocation. Publish updated signed metadata promptly.</p><ul id="review-operations-revocations"></ul><p id="review-operations-remaining"></p></details>
        <p id="review-operations-advisory" class="service-footnote"></p>
      </div>
    </section>
    <section id="review-history-panel" data-workspace-panel class="operations-panel service-panel" aria-labelledby="review-history-heading">
      <div class="service-heading"><div><p class="step-label">RELEASE HISTORY</p><h2 id="review-history-heading">Every release has a story.</h2><p>Find an extension to see what was submitted and what reviewers decided.</p></div><DashboardDrawing section="review-history-panel" compact /></div>
      <form id="review-history-form" class="history-lookup">
        <div class="form-field"><label for="review-history-namespace">Publisher</label><input id="review-history-namespace" placeholder="e.g. panicmako" autocomplete="off" required pattern="[a-z][a-z0-9-]{1,62}" maxlength="63" /></div>
        <div class="form-field"><label for="review-history-name">Extension</label><input id="review-history-name" placeholder="e.g. relay" autocomplete="off" required pattern="[a-z][a-z0-9-]{1,62}" maxlength="63" /></div><button class="button" type="submit">Find history ↗</button>
      </form>
      <p id="review-history-status" class="service-footnote" role="status" aria-live="polite">Choose an extension to see its versions and review decisions.</p>
      <div id="review-history-guide" class="service-welcome"><span class="welcome-symbol" aria-hidden="true">↶</span><div><h3>A clear trail, in one place.</h3><p>Use the two parts of an extension ID. For <code>panicmako.relay</code>, the publisher is <strong>panicmako</strong> and the extension is <strong>relay</strong>.</p><p>You can also open history directly from a package in your queue.</p></div></div>
      <p id="review-history-summary" class="history-summary"></p><div class="history-columns"><section><div class="service-section-heading"><h3>Submitted versions</h3><span>Package activity</span></div><ul id="review-history-versions"></ul></section><section><div class="service-section-heading"><h3>Review decisions</h3><span>The reasons behind each action</span></div><ul id="review-history-decisions"></ul></section></div>
    </section>
    <section id="review-appeals-panel" data-workspace-panel class="operations-panel service-panel" aria-labelledby="review-appeals-heading">
      <div class="service-heading"><div><p class="step-label">PUBLISHER APPEALS</p><h2 id="review-appeals-heading">Keep the conversation open.</h2><p>Read a publisher’s explanation alongside the original decision, then leave a clear reply.</p></div><DashboardDrawing section="review-appeals-panel" compact /></div>
      <p class="service-note">A reply explains your decision. It does not approve, reject, revoke, or publish a release.</p><p id="review-appeals-status" class="service-footnote" role="status" aria-live="polite">Appeals have not been loaded.</p><ul id="review-appeals" class="appeal-inbox"></ul>
    </section>

  </section>
</Operations>
<script>
  import "../../scripts/review";
</script>
