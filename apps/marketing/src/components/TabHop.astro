---
import Icon from './Icon.astro';
const paces = [
  { id: 'chill', name: 'Chill', description: 'A little sea breeze', wave: 'M8 43 C30 43 39 31 58 31 C74 31 79 43 100 43 C113 43 121 38 132 38', foam: 'M42 35 C57 26 72 30 81 37' },
  { id: 'flow', name: 'Flow', description: 'Find your rhythm', wave: 'M8 43 C30 44 39 13 67 16 C82 17 91 29 82 35 C75 39 68 32 74 28 C71 39 99 45 132 38', foam: 'M41 29 C48 19 61 13 74 19' },
  { id: 'turbo', name: 'Turbo', description: 'Chase the swell', wave: 'M8 43 C27 44 38 4 73 8 C94 10 101 28 87 34 C77 38 68 27 79 22 C62 23 68 47 101 43 L132 38', foam: 'M38 24 C49 7 69 4 85 15' },
];
const sunburst = Array.from({ length: 48 }, (_, i) => {
  const angle = i * Math.PI / 24 - Math.PI / 2;
  const radius = i % 2 === 0 ? 58 : 52;
  return `${60 + Math.cos(angle) * radius},${60 + Math.sin(angle) * radius}`;
}).join(' ');
---
<section class="arcade" id="tab-hop" data-arcade aria-labelledby="arcade-heading">
  <div class="arcade-wrap"><header class="arcade-heading"><div><span class="arcade-kicker">AFTER HOURS / THE MACO SURF CLUB</span><h2 id="arcade-heading">Less window chaos.<br/><em>More play.</em></h2></div><p>Three projects. One little ride.<br/>Ride the waves. Pack your tools. Beat the clock.</p></header>
    <div class="arcade-levels">
      <div class="arcade-level-intro"><span class="arcade-level-label">THE SURF REPORT</span><span>How’s your <em>flow?</em></span></div>
      <div class="arcade-selector" role="group" aria-label="Game pace">
        {paces.map((pace, i) => <button type="button" data-level={pace.id} aria-pressed={i === 0} aria-label={`${pace.name}: ${pace.description}`}>
          <svg class="arcade-swell" viewBox="0 0 140 58" fill="none" aria-hidden="true">
            <circle class="arcade-swell-sun" cx="98" cy="20" r="15"/>
            <path class="arcade-swell-fill" d={`${pace.wave} L132 53 L8 53 Z`}/>
            <path class="arcade-swell-line" d={pace.wave}/>
            <path class="arcade-swell-foam" d={pace.foam}/>
            <path class="arcade-swell-ripple" d="M17 51 Q35 46 50 50 M84 51 Q104 47 121 49"/>
          </svg>
          <span class="arcade-pace-name">{pace.name}<span class="arcade-pace-check" aria-hidden="true">↗</span></span>
          <span class="arcade-pace-description">{pace.description}</span>
        </button>)}
      </div>
      <span class="arcade-level-note" data-level-note>100 seconds · 4 hearts · 3 tools per project</span>
    </div><div class="arcade-cabinet"><div class="arcade-chrome"><span class="arcade-wordmark">tabs <span aria-hidden="true">✳</span></span><span>MACO SURF CLUB</span><div class="arcade-stats"><button type="button" class="arcade-restart" data-restart aria-label="Restart game"><span aria-hidden="true">↻</span> Restart</button><span data-score>BAG 00 / 15</span><span data-time>1:40</span><span data-lives>♡ ♡ ♡ ♡</span></div></div>
      <div class="arcade-scene"><canvas data-canvas width="1200" height="480" tabindex="0" aria-label="Maco surfing game. Switch project lanes and jump over window obstacles." aria-describedby="arcade-help"></canvas><div class="arcade-overlay" data-overlay><img class="arcade-mascot" src="/game/maco-surfer-v2.png" width="1536" height="1024" alt="Maco the shark surfing with a bag of tools" loading="lazy" decoding="async"/><span class="arcade-small" data-overlay-kicker>A TINY GAME ABOUT MAKING ROOM</span><h3 data-overlay-title>Maco’s got places to be.</h3><p data-overlay-copy>Catch your tools. Beat the clock.<br/>Every project needs a little love.</p><button type="button" data-start>Let’s surf <Icon name="ArrowUpRight" size={20}/></button></div></div>
      <div class="arcade-bottom">
        <svg class="arcade-shore" viewBox="0 0 1440 50" preserveAspectRatio="none" aria-hidden="true"><path d="M0 28 C160 51 230 8 390 26 S650 53 820 24 S1130 9 1270 26 S1400 35 1440 20 V50 H0Z" fill="#fffdf5"/><path d="M0 19 C160 42 230 0 390 17 S650 44 820 15 S1130 0 1270 17 S1400 26 1440 11" fill="none" stroke="#fffdf5" stroke-opacity=".55" stroke-width="2"/></svg>
        <div class="arcade-project-console">
          <div class="arcade-control-heading"><span>Pick your <em>current.</em></span><span><kbd>↑</kbd><kbd>↓</kbd> or <kbd>1</kbd>–<kbd>3</kbd></span></div>
          <div class="arcade-projects" role="group" aria-label="Switch project lanes">
            {['Studio site','Next product','Weekend idea'].map((name,i)=>
              <button type="button" data-lane={i} aria-pressed={i===1}>
                <span class="arcade-project-art" aria-hidden="true">
                  <svg viewBox="0 0 220 124" fill="none">
                    <ellipse class="arcade-art-halo" cx="110" cy="64" rx="65" ry="48"/>
                    <path class="arcade-art-water" d="M27 102 C45 83 80 91 107 89 C144 86 174 82 195 100 C181 118 140 119 111 116 C78 119 42 116 27 102Z"/>
                    <path class="arcade-art-wake" d="M33 103 Q57 97 76 102 M88 113 Q111 108 136 112 M149 102 Q172 96 191 101"/>
                    <g class="arcade-project-object">
                      {i === 0 && <g transform="rotate(-7 110 60)">
                        <rect class="arcade-art-shadow" x="57" y="28" width="113" height="76" rx="8"/>
                        <rect class="arcade-art-paper" x="50" y="20" width="113" height="76" rx="8"/>
                        <path class="arcade-art-line" d="M50 37 H163"/>
                        <circle class="arcade-art-ink" cx="60" cy="29" r="2"/><circle class="arcade-art-ink" cx="67" cy="29" r="2"/><circle class="arcade-art-ink" cx="74" cy="29" r="2"/>
                        <rect class="arcade-art-soft" x="60" y="48" width="42" height="37" rx="4"/>
                        <circle class="arcade-art-accent" cx="80" cy="62" r="9"/>
                        <path class="arcade-art-ink" d="M66 80 L81 68 L96 80Z"/>
                        <path class="arcade-art-line" d="M112 52 H151 M112 60 H143 M112 68 H147"/>
                        <rect class="arcade-art-ink" x="112" y="77" width="25" height="7" rx="3.5"/>
                        <path class="arcade-art-pointer" d="M155 68 L155 91 L162 85 L169 98 L175 94 L168 82 L179 80Z"/>
                      </g>}
                      {i === 1 && <g>
                        <g transform="rotate(7 135 46)"><rect class="arcade-art-shadow" x="87" y="20" width="84" height="67" rx="7"/><rect class="arcade-art-soft" x="81" y="14" width="84" height="67" rx="7"/><path class="arcade-art-line" d="M93 26 H132 M93 34 H120"/></g>
                        <g transform="rotate(-5 101 65)">
                          <rect class="arcade-art-shadow" x="54" y="43" width="109" height="61" rx="7"/>
                          <rect class="arcade-art-paper" x="47" y="36" width="109" height="61" rx="7"/>
                          <path class="arcade-art-line" d="M47 51 H156"/>
                          <circle class="arcade-art-ink" cx="57" cy="43" r="2"/><circle class="arcade-art-ink" cx="64" cy="43" r="2"/>
                          <path class="arcade-art-code" d="M80 64 L70 72 L80 80 M121 64 L131 72 L121 80 M107 61 L99 83"/>
                        </g>
                        <circle class="arcade-art-accent" cx="164" cy="83" r="13"/>
                        <path class="arcade-art-check" d="M158 83 L162 87 L170 79"/>
                      </g>}
                      {i === 2 && <g transform="rotate(6 108 62)">
                        <rect class="arcade-art-shadow" x="64" y="24" width="91" height="81" rx="4"/>
                        <rect class="arcade-art-soft" x="57" y="17" width="91" height="81" rx="4"/>
                        <path class="arcade-art-line" d="M68 30 H98 M68 37 H85"/>
                        <path class="arcade-art-stem" d="M106 78 C107 67 106 58 115 49 M108 68 C94 68 86 62 86 53 C99 51 108 56 108 68"/>
                        <path class="arcade-art-bloom" d="M115 37 L121 45 L131 43 L129 53 L137 59 L127 63 L126 73 L116 68 L108 75 L104 65 L94 63 L99 54 L94 46 L105 45 L107 35Z"/>
                        <circle class="arcade-art-accent" cx="115" cy="55" r="6"/>
                        <path class="arcade-art-paper" d="M93 79 H121 L117 96 H97Z"/>
                        <path class="arcade-art-line" d="M91 79 H123"/>
                        <path class="arcade-art-spark" d="M157 45 V57 M151 51 H163 M49 71 V79 M45 75 H53"/>
                      </g>}
                    </g>
                    <path class="arcade-art-spark" d="M181 27 V37 M176 32 H186"/>
                  </svg>
                  <span class="arcade-art-number">0{i+1}</span>
                </span>
                <span class="arcade-project-name">{name}</span>
                <span class="arcade-project-caption"><span class="arcade-project-state" aria-hidden="true"></span><span class="arcade-lane-count" data-lane-count={i}>0/3</span><span class="arcade-count-label">tools</span></span>
                <span class="arcade-lane-progress" aria-hidden="true"><span></span></span>
              </button>
            )}
          </div>
        </div>
        <div class="arcade-actions">
          <div class="arcade-jump-wrap">
            <span class="arcade-air-note" aria-hidden="true">Catch a little air ↘</span>
            <button type="button" class="arcade-jump" data-jump aria-label="Jump over window clutter">
              <svg class="arcade-jump-seal" viewBox="0 0 120 120" aria-hidden="true"><polygon points={sunburst}/><circle cx="60" cy="60" r="43" fill="none" stroke="currentColor" stroke-opacity=".3" stroke-dasharray="2 4"/></svg>
              <span class="arcade-jump-symbol"><Icon name="ArrowUp" size={20}/></span><span class="arcade-jump-label">Jump</span><kbd>SPACE</kbd>
            </button>
          </div>
          <button type="button" class="arcade-pause" data-pause disabled aria-label="Pause game"><span class="arcade-pause-ring" data-pause-symbol aria-hidden="true">Ⅱ</span><span data-pause-label>Pause</span></button>
        </div>
      </div></div>
    <div class="arcade-caption"><p role="status" aria-live="polite" data-message>All your projects and tools. A little less juggling.</p><span id="arcade-help">↑ ↓ OR 1–3 TO SWITCH · SPACE TO HOP<span> / TOUCH? USE THE BUTTONS.</span></span></div>
    <div class="arcade-foot"><span>SMALL GAME. BIG IDE.</span><a href="/downloads">Ready to build something real? Get Tabs <Icon name="ArrowUpRight" size={16}/></a><span>NO HIGH SCORE REQUIRED.</span></div><div class="arcade-legal"><span>© 2026 Tabs IDE. All rights reserved.</span><a href="https://github.com/PanicMako/Tabs-ide">Built in the open ↗</a></div>
    <noscript><p>Enable JavaScript to play. <a href="/downloads">Get Tabs</a>.</p></noscript>
  </div>
</section>
<style>
.arcade{background:#3259ed;color:#fff;min-height:100svh;padding:70px 0 20px;border-top:1px solid #ffffff70;font-family:'DM Sans',sans-serif;background-image:linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);background-size:54px 54px}.arcade-wrap{width:100%}.arcade-heading,.arcade-levels,.arcade-caption,.arcade-foot,.arcade-legal{width:min(1280px,89%);margin-inline:auto}.arcade-heading{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:28px}.arcade-kicker{font:9px monospace;letter-spacing:.1em;color:#c4ceff}.arcade-heading h2{font:500 clamp(36px,4vw,60px)/1.04 'DM Sans',sans-serif;letter-spacing:-.055em;margin:21px 0 0}.arcade-heading h2 em{font:400 1.17em 'Instrument Serif',Georgia,serif;color:#d9e2ff}.arcade-heading p{font-size:12px;line-height:1.8;color:#d3dcff}
.arcade-levels{display:flex;align-items:center;gap:38px;margin-block:35px 30px}
.arcade-level-intro{display:flex;flex-direction:column;gap:12px;flex-shrink:0}
.arcade-level-label{font:9px monospace;letter-spacing:.12em;color:#d3dcff}
.arcade-level-intro>span:last-child{font:400 25px/1.1 'Instrument Serif',Georgia,serif}
.arcade-level-intro em{color:#f7d0ad}
.arcade-selector{display:flex;gap:24px;width:470px;max-width:100%}
.arcade-selector button{position:relative;flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;border:0;border-radius:6px;background:none;padding:0 0 10px;color:#fff;cursor:pointer;opacity:.65;transition:opacity .25s,transform .35s}
.arcade-selector button:hover,.arcade-selector button[aria-pressed=true]{opacity:1}
.arcade-selector button:hover{transform:translateY(-3px)}
.arcade-swell{width:100%;max-width:140px;height:58px;overflow:visible}
.arcade-swell-sun{fill:#f7d0ad;transform:translateY(8px) scale(.65);transform-origin:98px 20px;opacity:0;transition:opacity .3s,transform .4s}
.arcade-selector button[aria-pressed=true] .arcade-swell-sun{opacity:1;transform:none}
.arcade-swell-fill{fill:#d5e9ff;fill-opacity:.16}
.arcade-swell-line{stroke:#e5eeff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.arcade-swell-foam{stroke:#fff;stroke-width:1.5;stroke-linecap:round}
.arcade-swell-ripple{stroke:#b9ceff;stroke-width:1;stroke-linecap:round}
.arcade-pace-name{display:flex;align-items:center;gap:9px;font:400 26px/1.2 'Instrument Serif',Georgia,serif;letter-spacing:-.025em}
.arcade-pace-check{font:14px 'DM Sans',sans-serif;color:#f7d0ad;opacity:0;transition:opacity .25s}
.arcade-selector button[aria-pressed=true] .arcade-pace-check{opacity:1}
.arcade-pace-description{font:10px 'DM Sans',sans-serif;color:#dce5ff;margin-top:6px}
.arcade-level-note{margin-left:auto;max-width:190px;font:10px/1.8 'DM Sans',sans-serif;color:#d3dcff}
.arcade-cabinet{overflow:hidden;color:#203452;background:#d4eaf7}.arcade-chrome{display:flex;gap:24px;align-items:center;padding:17px 5.5%;font:9px monospace;color:#69819b;background:#edf4fa;border-bottom:1px solid #b7ccdf55}.arcade-wordmark{font:600 21px 'DM Sans',sans-serif;letter-spacing:-.07em;color:#203452}.arcade-wordmark>span{color:#3259ed;font-size:25px;margin-left:8px}.arcade-stats{margin-left:auto;display:flex;gap:14px;align-items:center;color:#315be0}.arcade-stats>span{background:#fff9;border:1px solid #c6d7e866;padding:8px 13px;border-radius:99px;font:10px monospace}.arcade-stats [data-time]{color:#546c86}.arcade-scene{position:relative}.arcade-scene canvas{display:block;width:100%;height:70svh;min-height:450px;max-height:800px;outline-offset:-5px}.arcade-overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(90deg,#eff7fcbd,#eff7fcf2 45%,#eff7fce8);text-align:center;padding:20px;backdrop-filter:blur(4px)}.arcade-overlay[hidden]{display:none}.arcade-mascot{width:clamp(190px,22vw,320px);height:auto;object-fit:contain;filter:drop-shadow(0 17px 15px #38679720);margin-bottom:7px;transform:rotate(-4deg)}.arcade-small{font:8px monospace;letter-spacing:.14em;color:#7289a2}.arcade-overlay h3{font:400 clamp(33px,4vw,56px)/1.05 'Instrument Serif',Georgia,serif;margin:13px 0;color:#203452}.arcade-overlay p{font-size:12px;color:#6d8299;line-height:1.8;margin:0 0 20px;max-width:380px}.arcade-overlay button{display:flex;align-items:center;gap:35px;background:#3259ed;border:0;color:#fff;border-radius:99px;padding:15px 28px;font:600 13px 'DM Sans',sans-serif;cursor:pointer;box-shadow:0 7px 20px #3259ed28}

.arcade-bottom{position:relative;display:flex;align-items:center;justify-content:center;gap:60px;padding:22px 5.5% 28px;background:#fffdf5}
.arcade-shore{position:absolute;bottom:calc(100% - 1px);left:0;width:100%;height:40px;pointer-events:none}
.arcade-project-console{flex:1;max-width:790px;min-width:0}

.arcade-control-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 8px;color:#31485e}
.arcade-control-heading>span:first-child{font:400 25px/1 'Instrument Serif',Georgia,serif;letter-spacing:-.02em}
.arcade-control-heading em{color:#397c7a}
.arcade-control-heading>span:last-child{display:flex;align-items:center;gap:4px;font:9px monospace;color:#617584}
.arcade-control-heading kbd{font:9px monospace;border:1px solid #becbc9;border-radius:4px;padding:3px 4px}
.arcade-projects{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.arcade-projects button{--channel:#3259ed;--wash:#e1e8ff;--accent:#f3be98;display:flex;flex-direction:column;align-items:center;position:relative;min-width:0;border:0;border-radius:12px;background:none;padding:0 4px 12px;color:#2b425c;cursor:pointer}
.arcade-projects button:nth-of-type(2){--channel:#267c70;--wash:#d8eee2;--accent:#a5cfb2}
.arcade-projects button:nth-of-type(3){--channel:#99643e;--wash:#f8dfbd;--accent:#edbf78}
.arcade-project-art{position:relative;display:block;width:100%;max-width:220px}
.arcade-project-art svg{display:block;width:100%;height:auto;overflow:visible}
.arcade-art-halo{fill:var(--wash);opacity:0;transform:scale(.8);transform-origin:110px 64px;transition:opacity .35s,transform .45s}
.arcade-art-water{fill:var(--wash);opacity:.55;transition:opacity .3s}
.arcade-art-wake{stroke:var(--channel);stroke-width:1.2;stroke-linecap:round;opacity:.3}
.arcade-project-object{transform:translateY(4px);transform-origin:110px 64px;transition:transform .45s cubic-bezier(.22,1,.36,1)}
.arcade-art-shadow{fill:var(--channel);opacity:.12}
.arcade-art-paper{fill:#fffefa;stroke:var(--channel);stroke-opacity:.55;stroke-width:1.2}
.arcade-art-soft{fill:var(--wash);stroke:var(--channel);stroke-opacity:.3;stroke-width:1}
.arcade-art-line{stroke:var(--channel);stroke-opacity:.4;stroke-width:1.2;stroke-linecap:round}
.arcade-art-ink{fill:var(--channel)}
.arcade-art-accent{fill:var(--accent)}
.arcade-art-pointer{fill:var(--accent);stroke:#fffefa;stroke-width:2;stroke-linejoin:round}
.arcade-art-code{stroke:var(--channel);stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.arcade-art-check{stroke:var(--channel);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.arcade-art-stem{stroke:var(--channel);stroke-width:1.5;fill:var(--wash);stroke-linecap:round}
.arcade-art-bloom{fill:var(--channel);fill-opacity:.75;stroke:var(--channel);stroke-width:1;stroke-linejoin:round}
.arcade-art-spark{stroke:var(--channel);stroke-width:1.5;stroke-linecap:round;opacity:.45}
.arcade-art-number{position:absolute;left:8%;bottom:17%;font:9px monospace;color:var(--channel);opacity:.6}
.arcade-projects button[aria-pressed=true] .arcade-art-halo{opacity:.55;transform:scale(1)}
.arcade-projects button[aria-pressed=true] .arcade-art-water{opacity:1}
.arcade-projects button:hover .arcade-project-object{transform:translateY(-3px) rotate(-3deg)}
.arcade-projects button[aria-pressed=true] .arcade-project-object{animation:arcade-project-float 4s ease-in-out infinite}
.arcade-projects button[aria-pressed=true] .arcade-art-wake{stroke-dasharray:16 7;animation:arcade-current-drift 5s linear infinite}
.arcade-project-name{display:block;position:relative;margin-top:5px;font:400 clamp(18px,1.7vw,24px)/1.15 'Instrument Serif',Georgia,serif;letter-spacing:-.02em;text-align:center}
.arcade-projects button[aria-pressed=true] .arcade-project-name{color:var(--channel)}
.arcade-project-caption{display:flex;align-items:center;justify-content:center;gap:5px;margin-top:8px;min-height:14px;color:#5b706d}
.arcade-project-state{display:block;width:5px;height:5px;border:1px solid #92a6a0;border-radius:50%;margin-right:2px}
.arcade-projects button[aria-pressed=true] .arcade-project-state{background:var(--channel);border-color:var(--channel);box-shadow:0 0 0 3px var(--wash)}
.arcade-lane-count{font:10px monospace;color:#334f4b}
.arcade-count-label{font:9px 'DM Sans',sans-serif}
.arcade-lane-progress{display:block;width:44px;height:2px;background:#dce2d6;margin:9px auto 0}
.arcade-lane-progress>span{display:block;width:100%;height:100%;background:var(--channel);transform:scaleX(var(--progress,0));transform-origin:left;transition:transform .25s}
@keyframes arcade-project-float{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-5px) rotate(1deg)}}
@keyframes arcade-current-drift{to{stroke-dashoffset:-46}}
:global(.motion-paused) .arcade-project-object,:global(.motion-paused) .arcade-art-wake{animation:none!important}
.arcade-actions{display:flex;align-items:center;gap:28px}
.arcade-jump-wrap{position:relative}
.arcade-air-note{position:absolute;left:-25px;top:-16px;white-space:nowrap;font:italic 16px 'Instrument Serif',Georgia,serif;color:#66766b;transform:rotate(-7deg)}
.arcade-jump{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;width:116px;height:116px;border:0;border-radius:50%;background:none;color:#543d2d;cursor:pointer;transform:rotate(8deg);transition:transform .35s cubic-bezier(.22,1,.36,1)}
.arcade-jump-seal{position:absolute;inset:0;width:100%;height:100%;z-index:0;filter:drop-shadow(0 4px 0 #c99b7050)}
.arcade-jump-seal polygon{fill:#f7c49b;stroke:#c8976b;stroke-width:.6}
.arcade-jump-symbol,.arcade-jump-label,.arcade-jump kbd{position:relative}
.arcade-jump-symbol{display:flex}
.arcade-jump-label{font:400 31px/1 'Instrument Serif',Georgia,serif;letter-spacing:-.035em}
.arcade-jump kbd{font:8px monospace;letter-spacing:.1em;margin-top:6px}
.arcade-jump:hover{transform:translateY(-5px) rotate(-5deg)}
.arcade-jump:active{transform:translateY(2px) rotate(0deg)}
.arcade-pause{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;background:none;border:0;border-radius:8px;padding:7px 4px;color:#536d66;font:10px 'DM Sans',sans-serif;cursor:pointer}
.arcade-pause-ring{display:grid;place-items:center;width:44px;height:44px;border:1px solid #97b3a9;border-radius:50%;font:500 18px 'DM Sans',sans-serif;box-shadow:inset 0 0 0 4px #fffdf5,inset 0 0 0 5px #cedbd1;transition:background .2s,transform .2s}
.arcade-pause:hover:enabled .arcade-pause-ring{background:#d8eee2;transform:rotate(-8deg)}
.arcade-caption{display:flex;justify-content:space-between;gap:20px;margin-top:22px;min-height:32px;align-items:center}.arcade-caption p{font-size:12px;color:#e1e7ff;margin:0}.arcade-caption>span{font:8px/1.8 monospace;color:#b8c7ff}.arcade-foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #ffffff35;padding-top:24px;margin-top:30px;gap:20px}.arcade-foot>span{font:8px monospace;color:#bccaff;letter-spacing:.08em}.arcade-foot a{display:flex;align-items:center;gap:12px;font-size:12px;color:white;text-decoration:none}.arcade-legal{display:flex;justify-content:space-between;margin-top:27px;font-size:9px;color:#b9c9ff}.arcade-legal a{color:inherit;text-decoration:none}.arcade button:disabled{opacity:.45;cursor:default}.arcade button:focus-visible,.arcade a:focus-visible,.arcade canvas:focus-visible{outline:3px solid #a9baff;outline-offset:4px}.arcade-restart{display:inline-flex;align-items:center;gap:6px;border:1px solid #ccd9e6;background:#fff;color:#365371;border-radius:99px;padding:8px 12px;font:500 10px 'DM Sans',sans-serif;cursor:pointer}.arcade-restart:hover{background:#e8efff}.arcade-restart>span{font-size:15px;line-height:1}.arcade-stats [data-time].is-urgent{background:#ffebe0;color:#ab592f}

@media(max-width:1000px){.arcade-levels{gap:24px}.arcade-level-note{max-width:140px}.arcade-selector{gap:14px}.arcade-bottom{gap:28px;padding-inline:4%}.arcade-actions{gap:16px}.arcade-projects{gap:8px}.arcade-jump{width:100px;height:100px}.arcade-air-note{font-size:14px;left:-12px}}
