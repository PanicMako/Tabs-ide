---
import Icon from './Icon.astro';
---
<section class="arcade" id="tab-hop" data-arcade aria-labelledby="arcade-heading">
  <div class="arcade-wrap"><header class="arcade-heading"><div><span class="arcade-kicker">AFTER HOURS / THE MACO SURF CLUB</span><h2 id="arcade-heading">Less window chaos.<br/><em>More play.</em></h2></div><p>Three projects. One little ride.<br/>Ride the waves. Pack your tools. Beat the clock.</p></header>
    <div class="arcade-levels"><span class="arcade-level-label">YOUR PACE</span><div class="arcade-selector" role="group" aria-label="Game intensity"><span class="arcade-selector-thumb" aria-hidden="true"></span><button type="button" data-level="chill" aria-pressed="true">Chill<span>Warm up</span></button><button type="button" data-level="flow" aria-pressed="false">Flow<span>Find your rhythm</span></button><button type="button" data-level="turbo" aria-pressed="false">Turbo<span>Earn your stripes</span></button></div><span class="arcade-level-note" data-level-note>100 seconds · 4 hearts · visit every project</span></div><div class="arcade-cabinet"><div class="arcade-chrome"><span class="arcade-wordmark">tabs <span aria-hidden="true">✳</span></span><span>MACO SURF CLUB</span><div class="arcade-stats"><span data-score>BAG 00 / 15</span><span data-time>1:40</span><span data-lives>♡ ♡ ♡ ♡</span></div></div>
      <div class="arcade-scene"><canvas data-canvas width="1200" height="480" tabindex="0" aria-label="Maco surfing game. Switch project lanes and jump over window obstacles." aria-describedby="arcade-help"></canvas><div class="arcade-overlay" data-overlay><img class="arcade-mascot" src="/game/maco-surfer-v2.png" width="1536" height="1024" alt="Maco the shark surfing with a bag of tools" loading="lazy" decoding="async"/><span class="arcade-small" data-overlay-kicker>A TINY GAME ABOUT MAKING ROOM</span><h3 data-overlay-title>Maco’s got places to be.</h3><p data-overlay-copy>Catch your tools. Beat the clock.<br/>Every project needs a little love.</p><button type="button" data-start>Let’s surf <Icon name="ArrowUpRight" size={20}/></button></div></div>
      <div class="arcade-bottom"><div class="arcade-projects" role="group" aria-label="Switch project lanes"><span class="arcade-project-thumb" aria-hidden="true"></span>{['Studio site','Next product','Weekend idea'].map((name,i)=><button type="button" data-lane={i} aria-pressed={i===1}><span class="arcade-lane-dot" aria-hidden="true"></span><span class="arcade-project-name">{name}</span><span class="arcade-lane-count" data-lane-count={i}>0/3</span></button>)}</div><button type="button" class="arcade-jump" data-jump>Jump <span class="arcade-jump-symbol" aria-hidden="true">↟</span><kbd>SPACE</kbd></button><button type="button" class="arcade-pause" data-pause disabled aria-label="Pause game">Ⅱ</button></div></div>
    <div class="arcade-caption"><p role="status" aria-live="polite" data-message>All your projects and tools. A little less juggling.</p><span id="arcade-help">↑ ↓ OR 1–3 TO SWITCH · SPACE TO HOP<span> / TOUCH? USE THE BUTTONS.</span></span></div>
    <div class="arcade-foot"><span>SMALL GAME. BIG IDE.</span><a href="/downloads">Ready to build something real? Get Tabs <Icon name="ArrowUpRight" size={16}/></a><span>NO HIGH SCORE REQUIRED.</span></div><div class="arcade-legal"><span>© 2026 Tabs IDE. All rights reserved.</span><a href="https://github.com/PanicMako/Tabs-ide">Built in the open ↗</a></div>
    <div hidden data-tool-glyphs>{(['Code2','Bot','Terminal','Github','Globe'] as const).map(icon=><Icon name={icon} size={32}/>)}</div><noscript><p>Enable JavaScript to play. <a href="/downloads">Get Tabs</a>.</p></noscript>
  </div>
</section>
<style>
.arcade{background:#3259ed;color:#fff;min-height:100svh;padding:70px 0 20px;border-top:1px solid #ffffff70;font-family:'DM Sans',sans-serif;background-image:linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);background-size:54px 54px}.arcade-wrap{width:100%}.arcade-heading,.arcade-levels,.arcade-caption,.arcade-foot,.arcade-legal{width:min(1280px,89%);margin-inline:auto}.arcade-heading{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:28px}.arcade-kicker{font:9px monospace;letter-spacing:.1em;color:#c4ceff}.arcade-heading h2{font:500 clamp(36px,4vw,60px)/1.04 'DM Sans',sans-serif;letter-spacing:-.055em;margin:21px 0 0}.arcade-heading h2 em{font:400 1.17em 'Instrument Serif',Georgia,serif;color:#d9e2ff}.arcade-heading p{font-size:12px;line-height:1.8;color:#d3dcff}.arcade-levels{display:flex;align-items:center;gap:20px;margin-bottom:26px}.arcade-level-label,.arcade-level-note{font:9px monospace;color:#c3d0ff}.arcade-level-note{margin-left:auto}.arcade-selector{position:relative;display:flex;border:1px solid #ffffff30;background:#1734b53b;border-radius:99px;padding:5px;isolation:isolate;width:380px}.arcade-selector-thumb{position:absolute;inset:5px auto 5px 5px;width:calc((100% - 10px)/3);background:#fff;border-radius:99px;box-shadow:0 4px 16px #152ea830;transform:translateX(calc(var(--level-index,0)*100%));transition:transform .35s cubic-bezier(.22,1,.36,1);z-index:-1}.arcade-selector button{flex:1;background:none;border:0;color:#cbd6ff;padding:11px 10px;border-radius:99px;font:600 12px 'DM Sans',sans-serif;cursor:pointer}.arcade-selector button span{display:block;font:9px 'DM Sans',sans-serif;margin-top:3px;opacity:.65}.arcade-selector button[aria-pressed=true]{color:#2349d8}.arcade-cabinet{overflow:hidden;color:#203452;background:#d4eaf7}.arcade-chrome{display:flex;gap:24px;align-items:center;padding:17px 5.5%;font:9px monospace;color:#69819b;background:#edf4fa;border-bottom:1px solid #b7ccdf55}.arcade-wordmark{font:600 21px 'DM Sans',sans-serif;letter-spacing:-.07em;color:#203452}.arcade-wordmark>span{color:#3259ed;font-size:25px;margin-left:8px}.arcade-stats{margin-left:auto;display:flex;gap:14px;align-items:center;color:#315be0}.arcade-stats>span{background:#fff9;border:1px solid #c6d7e866;padding:8px 13px;border-radius:99px;font:10px monospace}.arcade-stats [data-time]{color:#546c86}.arcade-scene{position:relative}.arcade-scene canvas{display:block;width:100%;height:70svh;min-height:450px;max-height:800px;outline-offset:-5px}.arcade-overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(90deg,#eff7fcbd,#eff7fcf2 45%,#eff7fce8);text-align:center;padding:20px;backdrop-filter:blur(4px)}.arcade-overlay[hidden]{display:none}.arcade-mascot{width:clamp(190px,22vw,320px);height:auto;object-fit:contain;filter:drop-shadow(0 17px 15px #38679720);margin-bottom:7px;transform:rotate(-4deg)}.arcade-small{font:8px monospace;letter-spacing:.14em;color:#7289a2}.arcade-overlay h3{font:400 clamp(33px,4vw,56px)/1.05 'Instrument Serif',Georgia,serif;margin:13px 0;color:#203452}.arcade-overlay p{font-size:12px;color:#6d8299;line-height:1.8;margin:0 0 20px;max-width:380px}.arcade-overlay button{display:flex;align-items:center;gap:35px;background:#3259ed;border:0;color:#fff;border-radius:99px;padding:15px 28px;font:600 13px 'DM Sans',sans-serif;cursor:pointer;box-shadow:0 7px 20px #3259ed28}.arcade-bottom{display:flex;gap:13px;align-items:center;justify-content:center;padding:17px 5.5%;background:#edf5fa;border-top:1px solid #b9cde055}.arcade-projects{position:relative;display:flex;background:#dbe6ee;border:1px solid #c9d9e6;border-radius:99px;padding:5px;isolation:isolate;width:590px}.arcade-project-thumb{position:absolute;inset:5px auto 5px 5px;width:calc((100% - 10px)/3);border-radius:99px;background:#fff;box-shadow:0 4px 12px #234a7510;transform:translateX(calc(var(--lane-index,1)*100%));transition:transform .3s cubic-bezier(.22,1,.36,1);z-index:-1}.arcade-projects button{flex:1;min-width:0;display:flex;align-items:center;justify-content:center;gap:9px;border:0;background:none;padding:13px 10px;font:500 11px 'DM Sans',sans-serif;color:#8194a7;border-radius:99px;cursor:pointer}.arcade-projects button[aria-pressed=true]{color:#254866}.arcade-lane-dot{width:5px;height:5px;border-radius:50%;background:#7095df;flex-shrink:0}.arcade-projects button:nth-of-type(2) .arcade-lane-dot{background:#5b9e92}.arcade-projects button:nth-of-type(3) .arcade-lane-dot{background:#9b88bc}.arcade-lane-count{font:8px monospace;color:#8ba0b2}.arcade-jump{display:flex;align-items:center;gap:13px;border:1px solid #34557c;background:#203c60;color:white;border-radius:99px;padding:14px 20px;font:500 12px 'DM Sans',sans-serif;cursor:pointer;box-shadow:0 4px 0 #142840;transition:transform .12s,box-shadow .12s}.arcade-jump:active{transform:translateY(3px);box-shadow:0 1px 0 #142840}.arcade-jump-symbol{font-size:20px;line-height:1}.arcade-jump kbd{font:8px monospace;color:#92aecb;border:1px solid #557090;padding:4px 5px;border-radius:5px}.arcade-pause{background:#dbe6ee;border:1px solid #c9d9e6;color:#55728f;min-width:43px;height:43px;border-radius:50%;font:600 15px 'DM Sans',sans-serif;cursor:pointer}.arcade-caption{display:flex;justify-content:space-between;gap:20px;margin-top:22px;min-height:32px;align-items:center}.arcade-caption p{font-size:12px;color:#e1e7ff;margin:0}.arcade-caption>span{font:8px/1.8 monospace;color:#b8c7ff}.arcade-foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #ffffff35;padding-top:24px;margin-top:30px;gap:20px}.arcade-foot>span{font:8px monospace;color:#bccaff;letter-spacing:.08em}.arcade-foot a{display:flex;align-items:center;gap:12px;font-size:12px;color:white;text-decoration:none}.arcade-legal{display:flex;justify-content:space-between;margin-top:27px;font-size:9px;color:#b9c9ff}.arcade-legal a{color:inherit;text-decoration:none}.arcade button:disabled{opacity:.45;cursor:default}.arcade button:focus-visible,.arcade a:focus-visible,.arcade canvas:focus-visible{outline:3px solid #a9baff;outline-offset:4px}.arcade-stats [data-time].is-urgent{background:#ffebe0;color:#ab592f}
@media(max-width:760px){.arcade{padding-top:45px}.arcade-heading,.arcade-levels,.arcade-caption,.arcade-foot,.arcade-legal{width:calc(100% - 40px)}.arcade-heading{display:block}.arcade-heading p{margin-top:20px}.arcade-level-label,.arcade-level-note{display:none}.arcade-selector{width:100%}.arcade-chrome{padding:12px 15px;gap:8px}.arcade-chrome>span:nth-child(2){display:none}.arcade-stats{gap:5px}.arcade-stats>span{font-size:8px;padding:7px 8px}.arcade-scene canvas{height:65svh;min-height:450px}.arcade-bottom{flex-wrap:wrap;padding:12px;gap:12px}.arcade-projects{width:100%;flex-basis:100%}.arcade-projects button{padding:12px 7px;font-size:9px;gap:5px}.arcade-lane-count{font-size:7px}.arcade-jump{margin-left:auto}.arcade-pause{margin-right:auto}.arcade-caption{display:block}.arcade-caption>span{display:block;margin-top:12px}.arcade-caption>span>span,.arcade-foot>span{display:none}.arcade-foot{justify-content:center}.arcade-legal{font-size:8px}.arcade-selector button span{font-size:8px}}
@media(prefers-reduced-motion:reduce){.arcade-selector-thumb,.arcade-project-thumb,.arcade-jump{transition:none}}
</style>
<script>
import '../lib/window-surfer';
</script>
