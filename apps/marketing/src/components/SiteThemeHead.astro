---
import "../styles/scrollbars.css";
---
<link rel="icon" href="/favicon.ico?v=3" sizes="any" />
<link rel="icon" href="/tabs.svg?v=3" type="image/svg+xml" />
<link rel="icon" href="/favicon-32x32.png?v=3" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-16x16.png?v=3" type="image/png" sizes="16x16" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
<script is:inline>
  document.documentElement.dataset.siteTheme = "light";
  try { localStorage.removeItem("tabs-site-theme"); } catch {}
</script>
<style is:global>:root { color-scheme:light; }</style>
