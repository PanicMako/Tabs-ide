{
  "name": "@tabs/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "4.0.0-beta.78",
      "@effect/platform-node": "4.0.0-beta.78",
      "@effect/platform-node-shared": "4.0.0-beta.78",
      "@effect/sql-sqlite-bun": "4.0.0-beta.78",
      "@effect/vitest": "4.0.0-beta.78",
      "@effect/atom-react": "4.0.0-beta.78",
      "@effect/language-service": "0.86.2",
      "@types/bun": "^1.3.14",
      "@types/node": "^24.13.0",
      "tsdown": "^0.22.2",
      "typescript": "^5.7.3",
      "vitest": "^4.1.8",
      "vite-plus": "0.2.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-runner.ts dev",
    "dev:server": "bun scripts/dev-runner.ts dev:server",
    "dev:web": "bun scripts/dev-runner.ts dev:web",
    "dev:marketing": "turbo run dev --filter=@tabs/marketing",
    "dev:desktop": "bun scripts/dev-runner.ts dev:desktop",
    "start": "turbo run start --filter=tabs",
    "start:desktop": "turbo run start --filter=@tabs/desktop",
    "start:marketing": "turbo run preview --filter=@tabs/marketing",
    "build": "turbo run build",
    "build:marketing": "turbo run build --filter=@tabs/marketing",
    "build:desktop": "turbo run build --filter=@tabs/desktop --filter=tabs",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "turbo run test",
    "check:effect-versions": "bun scripts/check-effect-versions.ts",
    "test:desktop-smoke": "turbo run smoke-test --filter=@tabs/desktop",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build:contracts": "turbo run build --filter=@tabs/contracts",
    "dist:desktop:artifact": "bun scripts/build-desktop-artifact.ts",
    "dist:desktop:dmg": "bun scripts/build-desktop-artifact.ts --platform mac --target dmg",
    "dist:desktop:dmg:arm64": "bun scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "dist:desktop:dmg:x64": "bun scripts/build-desktop-artifact.ts --platform mac --target dmg --arch x64",
    "dist:desktop:linux": "bun scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "dist:desktop:win": "bun scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64",
    "release:smoke": "bun scripts/release-smoke.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .turbo apps/*/.turbo packages/*/.turbo",
    "sync:vscode-icons": "node scripts/sync-vscode-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "chrome-remote-interface": "^0.34.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "playwright": "^1.61.1",
    "turbo": "^2.10.12",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.78",
    "undici-types": "8.11.0",
    "vite": "^8.0.16"
  },
  "engines": {
    "bun": "^1.3.9",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.9",
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}
