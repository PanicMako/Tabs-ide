---
import Concepts from "../components/Concepts.astro";
import SiteScripts from "../components/SiteScripts.astro";
import PageLoader from "../components/PageLoader.astro";
import SiteThemeHead from "../components/SiteThemeHead.astro";
import SeoHead from "../components/SeoHead.astro";
import "../styles/concepts.css";

const title = "Tabs IDE — AI Coding Workspace for Code, Agents, Git & Browser";
const description = "Every project gets a tab. Bring code, AI agents, launchpad presets, Git, a browser, and your own tools into one desktop coding workspace.";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Tabs IDE",
    alternateName: ["Tabs", "Build with Tabs"],
    url: "https://buildwithtabs.com/",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Tabs IDE",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Windows, Linux",
    description,
    url: "https://buildwithtabs.com/",
    downloadUrl: "https://buildwithtabs.com/downloads",
    softwareHelp: "https://github.com/PanicMako/Tabs-ide",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#fbfcfe"/>
    <title>{title}</title>
    <SeoHead title={title} description={description} structuredData={structuredData} />
    <SiteThemeHead />
  </head>
  <body>
    <PageLoader />
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main"><Concepts /></main>
    <SiteScripts />
    <script>import "../lib/motion"; import "../lib/headspace-motion";</script>
  </body>
</html>
