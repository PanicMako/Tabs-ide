---
import SiteShell from "../components/lab/SiteShell.astro";
import ConceptPortal from "../components/lab/ConceptPortal.astro";

const title = "Tabs IDE — AI Coding Workspace for Code, Agents, Git & Browser";
const description = "Every project gets a tab. Bring code, AI agents, Dock presets, Git, a browser, and your own tools into one desktop coding workspace.";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Tabs IDE",
    alternateName: ["Tabs", "Build with Tabs"],
    url: "https://buildwithtabs.com/",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Tabs IDE",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Windows, Linux",
    description,
    url: "https://buildwithtabs.com/",
    downloadUrl: "https://buildwithtabs.com/downloads",
    softwareHelp: "https://github.com/PanicMako/Tabs-ide",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  },
];
---
<SiteShell title={title} description={description} path="/" structuredData={structuredData}>
  <ConceptPortal />
</SiteShell>
