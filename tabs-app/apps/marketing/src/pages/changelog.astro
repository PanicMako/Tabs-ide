---
import SiteShell from "../components/lab/SiteShell.astro";
import ChangelogJournal from "../components/lab/ChangelogJournal.astro";

const title = "Tabs IDE Changelog — Release Notes and Downloads";
const description = "Read the latest Tabs IDE release notes, features, fixes, and download links, updated automatically from verified GitHub releases.";
---
<SiteShell title={title} description={description} path="/changelog" type="article">
  <ChangelogJournal />
</SiteShell>
