---
import TabsLogo from "./TabsLogo.astro";
import { TABS_MARK } from "@tabs/shared/tabsBrand";

// Keep the approved silhouette; animate the eye cutouts independently.
const silhouette = `${TABS_MARK.main.split(" Z M")[0]} Z`;
---
<div id="tabs-page-loader" class="page-loader" hidden>
  <div class="loader-wordmark"><TabsLogo size={32} /><span>Tabs</span></div>
  <div class="loader-composition">
    <button class="loader-mascot" id="loader-mascot" type="button" aria-label="Play with the Tabs mascot">
      <svg class="loader-drawing" viewBox="-155 -35 640 490" aria-hidden="true">
        <defs>
          <mask id="loader-eye-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="390" height="390">
            <path fill="white" d={silhouette} />
            <g class="mascot-eyes"><g class="mascot-eye-follow">
              <rect class="mascot-eye" fill="black" x="65" y="108" width="23" height="56" rx="11.5"/>
              <rect class="mascot-eye" fill="black" x="126" y="108" width="23" height="56" rx="11.5"/>
            </g></g>
          </mask>
        </defs>
        <g class="mascot-performance">
          <g class="mascot-body"><path d={silhouette} mask="url(#loader-eye-mask)" /></g>
          <g class="mascot-piece-reaction"><path class="mascot-detached" d={TABS_MARK.detached} /></g>
        </g>
      </svg>
    </button>
    <div class="loader-caption" aria-hidden="true"><span>Many moving parts.</span><span>One place.</span></div>
    <span class="sr-only" role="status">Opening Tabs</span>
  </div>
  <div class="loader-footer"><span>A little room for everything.</span><button id="loader-skip" type="button">Skip intro <span aria-hidden="true">↗</span></button></div>
</div>
<style>
  .page-loader {
    --intro-ink: #0e2af3;
    --intro-ground: #f3efe9;
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: var(--intro-ground);
    color: var(--intro-ink);
    overflow: hidden;
    clip-path: inset(0);
    transition: clip-path .7s cubic-bezier(.76,0,.24,1), visibility 0s .7s;
  }
  .page-loader[hidden] { display: none; }
  .page-loader.loader-dismissed { clip-path: inset(0 0 100% 0); visibility: hidden; pointer-events: none; }
  .loader-wordmark { position: absolute; top: 6%; left: 6%; display: flex; align-items: center; gap: 11px; }
  .loader-wordmark > span { font: 600 25px/1 "DM Sans",sans-serif; letter-spacing: -.055em; }
  .loader-composition { position: absolute; left: 50%; top: 47%; transform: translate(-50%,-50%); width: min(490px,88vw); }
  .loader-mascot { display: block; width: 100%; padding: 0; border: 0; background: transparent; cursor: pointer; color: inherit; border-radius: 28px; touch-action: manipulation; }
  .loader-drawing { display: block; width: 100%; overflow: visible; fill: currentColor; }
  .mascot-body { transform-origin: 205px 378px; animation: body-performance 4.2s both; }
  .mascot-eyes { animation: eyes-search 4.2s both; }
  .mascot-eye-follow { transform: translate(var(--look-x,0px),var(--look-y,0px)); transition: transform .18s ease-out; }
  .mascot-eye { transform-box: fill-box; transform-origin: center; animation: eyes-blink 4.2s both; }
  .mascot-detached { transform-origin: 94px 315px; animation: piece-find-home 4.2s both; }
  .mascot-piece-reaction { transform-origin: 94px 315px; }
  .loader-caption { position: relative; height: 36px; margin-top: 8px; text-align: center; font: 500 clamp(21px,3vw,29px)/1.25 "DM Sans",sans-serif; letter-spacing: -.045em; }
  .loader-caption span { position: absolute; inset: 0; }
  .loader-caption span:first-child { animation: caption-search 4.2s both; }
  .loader-caption span:last-child { animation: caption-home 4.2s both; }
  .loader-footer { position: absolute; bottom: 5%; left: 6%; right: 6%; display: flex; align-items: center; justify-content: space-between; gap: 20px; color: #111318; font: 400 14px/1.5 "DM Sans",sans-serif; }
  .loader-footer button { border: 0; background: none; color: inherit; padding: 12px 0 12px 16px; cursor: pointer; font: inherit; }
  .loader-footer button span { display: inline-block; margin-left: 8px; transition: transform .2s; }
  .loader-footer button:hover span { transform: translate(2px,-2px); }
  button:focus-visible { outline: 2px solid var(--intro-ink); outline-offset: 5px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  /* Hold each glance long enough to read as a decision, then catch the loose piece. */
  @keyframes eyes-search {
    0%,8% { transform: translate(0,0); animation-timing-function: cubic-bezier(.2,.8,.2,1); }
    14%,25% { transform: translate(-15px,-2px); animation-timing-function: cubic-bezier(.2,.8,.2,1); }
    31%,40% { transform: translate(17px,0); animation-timing-function: cubic-bezier(.2,.8,.2,1); }
    46%,52% { transform: translate(-12px,12px); animation-timing-function: cubic-bezier(.2,.8,.2,1); }
    60%,66% { transform: translate(-3px,9px); animation-timing-function: cubic-bezier(.2,.8,.2,1); }
    72%,100% { transform: translate(0,0); }
  }
  @keyframes eyes-blink {
    0%,69%,76%,100% { transform: scaleY(1); }
    72%,73% { transform: scaleY(.09); }
  }
  @keyframes body-performance {
    0%,9% { transform: rotate(0); animation-timing-function: cubic-bezier(.2,.8,.2,1); }
    16%,25% { transform: rotate(-3deg); animation-timing-function: cubic-bezier(.2,.8,.2,1); }
    32%,39% { transform: rotate(2deg); animation-timing-function: cubic-bezier(.2,.8,.2,1); }
    47%,53% { transform: rotate(-4deg); animation-timing-function: cubic-bezier(.3,0,.2,1); }
    60% { transform: translateY(4px) scale(1.025,.975); animation-timing-function: cubic-bezier(.2,.8,.2,1); }
    67% { transform: translateY(-3px) scale(.99,1.01); }
    75%,100% { transform: none; }
  }
  @keyframes piece-find-home {
    0%,35% { opacity: 0; transform: translate(-145px,45px) rotate(-18deg); animation-timing-function: cubic-bezier(.16,1,.3,1); }
    43% { opacity: 1; transform: translate(-100px,28px) rotate(-18deg); animation-timing-function: cubic-bezier(.3,0,.25,1); }
    51% { opacity: 1; transform: translate(-62px,-45px) rotate(8deg); animation-timing-function: cubic-bezier(.4,0,.75,1); }
    60% { opacity: 1; transform: translate(6px,3px) rotate(-2deg); animation-timing-function: cubic-bezier(.2,.8,.2,1); }
    67% { opacity: 1; transform: translate(-2px,-2px) rotate(1deg); }
    75%,100% { opacity: 1; transform: none; }
  }
  @keyframes caption-search { 0%,58% { opacity: 1; transform: none; } 65%,100% { opacity: 0; transform: translateY(-12px); } }
  @keyframes caption-home { 0%,64% { opacity: 0; transform: translateY(12px); } 76%,100% { opacity: 1; transform: none; } }
  @media(max-height:600px) {
    .loader-composition { width: min(290px,58vw); top: 46%; }
    .loader-caption { font-size: 20px; margin-top: 0; }
    .loader-wordmark { top: 5%; }
    .loader-footer { bottom: 3%; }
  }
  @media(max-width:420px) { .loader-footer { font-size: 12px; gap: 10px; } }
  @media(prefers-reduced-motion:reduce) { .page-loader { display: none; } .mascot-eye-follow { transition: none; } }
</style>
<script>
  const loader = document.getElementById("tabs-page-loader");
  const skip = document.getElementById("loader-skip");
  const main = document.getElementById("main");
  const mascot = document.getElementById("loader-mascot");
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  if (loader && mascot && !reducedMotion.matches) {
    loader.hidden = false;
    if (main) main.inert = true;
    let finished = false;
    let reaction: Animation | undefined;
    const resetGaze = () => {
      mascot.style.setProperty("--look-x", "0px");
      mascot.style.setProperty("--look-y", "0px");
    };
    const look = (event: PointerEvent) => {
      const rect = mascot.getBoundingClientRect();
      const scale = 640 / rect.width;
      mascot.style.setProperty("--look-x", `${Math.max(-5, Math.min(5, (event.clientX - rect.left - rect.width / 2) * scale * .025))}px`);
      mascot.style.setProperty("--look-y", `${Math.max(-4, Math.min(4, (event.clientY - rect.top - rect.height / 2) * scale * .025))}px`);
    };
    const play = () => {
      reaction?.cancel();
      reaction = mascot.querySelector(".mascot-piece-reaction")?.animate([
        { transform: "translateY(0) rotate(0)" },
        { transform: "translateY(-24px) rotate(-7deg)", offset: .42 },
        { transform: "translateY(0) rotate(0)" },
      ], { duration: 620, easing: "cubic-bezier(.2,.8,.2,1)" });
    };
    const onKey = (event: KeyboardEvent) => { if (event.key === "Escape") dismiss(); };
    const onMotionChange = () => { if (reducedMotion.matches) dismiss(); };
    const dismiss = () => {
      if (finished) return;
      finished = true;
      clearTimeout(timer);
      reaction?.cancel();
      document.removeEventListener("keydown", onKey);
      reducedMotion.removeEventListener("change", onMotionChange);
      mascot.removeEventListener("pointermove", look);
      mascot.removeEventListener("pointerleave", resetGaze);
      mascot.removeEventListener("click", play);
      skip?.removeEventListener("click", dismiss);
      if (main) main.inert = false;
      if (loader.contains(document.activeElement)) main?.querySelector<HTMLAnchorElement>("a")?.focus({ preventScroll: true });
      loader.classList.add("loader-dismissed");
      document.dispatchEvent(new Event("tabs:intro-complete"));
      window.setTimeout(() => { loader.hidden = true; }, 750);
    };
    document.addEventListener("keydown", onKey);
    reducedMotion.addEventListener("change", onMotionChange);
    mascot.addEventListener("pointermove", look);
    mascot.addEventListener("pointerleave", resetGaze);
    mascot.addEventListener("click", play);
    skip?.addEventListener("click", dismiss);
    // A short brand performance, never tied to network or download progress.
    const timer = window.setTimeout(dismiss, 4450);
  }
</script>
