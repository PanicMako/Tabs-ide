---
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import { ArrowUpRight, ArrowUp, ArrowDown, Code2, GitBranch, Bot, Terminal, Globe, CheckCircle, Layers, Sun, Moon, Rocket } from 'lucide-react';
const icons = { ArrowUpRight, ArrowUp, ArrowDown, Code2, GitBranch, Bot, Terminal, Globe, CheckCircle, Layers, Sun, Moon, Rocket };
interface Props { name: keyof typeof icons; size?: number; }
const { name, size = 20 } = Astro.props;
const svg = renderToStaticMarkup(createElement(icons[name], { size, strokeWidth: 1.6, 'aria-hidden': true }));
---
<Fragment set:html={svg} />
