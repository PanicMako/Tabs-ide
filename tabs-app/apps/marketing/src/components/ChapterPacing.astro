---
interface Props { tone?: "blue" | "paper" | "mist" }
const { tone = "paper" } = Astro.props;
---
<div class:list={["chapter-pacing", `chapter-pacing-${tone}`]} data-chapter-pacing>
  <div class="chapter-stage" data-chapter-stage><slot /></div>
</div>
<style>
  .chapter-pacing { position: relative; padding-bottom: clamp(48px, 14svh, 150px); background: #fbfcfe; }
  .chapter-pacing-blue { background-color: #3259ed; background-image: linear-gradient(#ffffff0b 1px, transparent 1px), linear-gradient(90deg, #ffffff0b 1px, transparent 1px); background-size: 54px 54px; }
  .chapter-pacing-mist { background: #f0f3fc; }
  .chapter-pacing.is-held { min-height: calc(var(--chapter-height) + 38svh); padding-bottom: 0; }
  .is-held > .chapter-stage { position: sticky; top: var(--chapter-top, 0px); }
  @media (max-width: 700px), (prefers-reduced-motion: reduce) {
    .chapter-pacing, .chapter-pacing.is-held { min-height: 0; padding-bottom: 44px; }
    .is-held > .chapter-stage { position: relative; top: auto; }
  }
  :global(.motion-paused) .chapter-pacing { min-height: 0; padding-bottom: 44px; }
  :global(.motion-paused) .chapter-stage { position: relative; top: auto; }
</style>
<script>
  const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter-pacing]")];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const narrow = matchMedia("(max-width: 700px)");
  const controller = new AbortController();
  const animations = new Set<Animation>();
  let frame = 0;
  const motionAllowed = () => !reduced.matches && !document.documentElement.classList.contains("motion-paused");
  const measure = () => {
    frame = 0;
    chapters.forEach(chapter => {
      const stage = chapter.querySelector<HTMLElement>("[data-chapter-stage]");
      if (!stage) return;
      const height = stage.offsetHeight;
      chapter.style.setProperty("--chapter-height", `${height}px`);
      chapter.style.setProperty("--chapter-top", `${Math.max(0, (innerHeight - height) / 2)}px`);
      chapter.classList.toggle("is-held", motionAllowed() && !narrow.matches && height <= innerHeight + 1);
    });
    if (!motionAllowed()) animations.forEach(animation => animation.cancel());
  };
  const schedule = () => { if (!frame) frame = requestAnimationFrame(measure); };
  const resize = new ResizeObserver(schedule);
  const motionState = new MutationObserver(schedule);
  const entering = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      entering.unobserve(entry.target);
      if (!motionAllowed()) return;
      const animation = entry.target.animate([
        { opacity: .35, transform: "translateY(24px)" },
        { opacity: 1, transform: "none" },
      ], { duration: 850, easing: "cubic-bezier(.22,1,.36,1)" });
      animations.add(animation);
      void animation.finished.catch(() => {}).finally(() => animations.delete(animation));
    });
  }, { rootMargin: "0px 0px -12% 0px", threshold: 0 });
  chapters.forEach(chapter => {
    const stage = chapter.querySelector<HTMLElement>("[data-chapter-stage]");
    if (stage) { resize.observe(stage); entering.observe(stage); }
  });
  motionState.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  window.addEventListener("resize", schedule, { signal: controller.signal });
  reduced.addEventListener("change", schedule, { signal: controller.signal });
  narrow.addEventListener("change", schedule, { signal: controller.signal });
  measure();
  document.addEventListener("astro:before-swap", () => {
    controller.abort(); resize.disconnect(); entering.disconnect(); motionState.disconnect();
    cancelAnimationFrame(frame); animations.forEach(animation => animation.cancel());
  }, { once: true });
</script>
