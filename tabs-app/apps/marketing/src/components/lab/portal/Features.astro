---
/**
 * Sub-agents and Overmind: how Tabs puts more than one agent on a job.
 * Three sections, in two files under ./features:
 *   Graph · sub-agents next to Overmind, then one Overmind run followed down the page
 *   Crew  · any provider for any kind of work
 * Motion that only needs "on screen yet?" is CSS, switched on by `[data-in]` -> `.in`.
 */
import ProviderLogo from "./ProviderLogo.astro";
import Graph from "./features/Graph.astro";
import Crew from "./features/Crew.astro";
import { agents } from "../../../data/lab";
---
<div class="fx" id="overmind" data-sec="Overmind" data-fx-agents={JSON.stringify(agents.map(({ id, name }) => ({ id, name })))}>
  <Graph />
  <Crew />
  <template data-fx-logos>{agents.map((a) => <ProviderLogo id={a.id} size={24} />)}</template>
</div>

<style is:global>
  .fx { position: relative; }
  .fx-sec { padding: clamp(96px, 11vw, 170px) 0; }
  .fx-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(24px, 4vw, 72px); align-items: end; }
  .fx-lede { margin: 24px 0 0; max-width: 34em; font-size: clamp(17px, 1.35vw, 20px); line-height: 1.45; color: var(--mute); }
  .fx-head .fx-lede { margin: 0 0 10px; }
  .fx [data-in] { opacity: 0; translate: 0 32px; transition: opacity .9s, translate 1.1s cubic-bezier(.2, 1, .3, 1); transition-delay: calc(var(--d, 0) * 1ms); }
  .fx [data-in].in { opacity: 1; translate: 0 0; }
  /* Site buttons (.v1-btn) keep their own type and colour. */
  .fx button:not(.v1-btn) { font: inherit; color: inherit; }
  .fx :focus-visible { outline: 2px solid var(--cobalt); outline-offset: 3px; }
  @media (max-width: 900px) { .fx-head { grid-template-columns: 1fr; gap: 18px; } }
  @media (prefers-reduced-motion: reduce) { .fx [data-in] { opacity: 1; translate: none; transition: none; } }
</style>

<script>
  import { reveal } from "../../../lib/lab/fx";
  reveal(document.querySelector<HTMLElement>(".fx")!);
</script>
