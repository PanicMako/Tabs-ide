---
/**
 * Only in Tabs: any agent can hand work to an agent from any other provider.
 * `rl` · Six reels, one per kind of work, with all fourteen providers on each. The lead's
 * reel is dark. Nudge a reel, click it, or spin them all; the sentence underneath follows.
 */
import { roles } from "../../../../data/overmind";
---
<section class="fx-sec rl">
  <div class="v1-wrap">
    <div class="fx-head">
      <div>
        <p class="v1-kicker" data-in>Only in Tabs</p>
        <h2 data-in>The best model <em>for every job.</em></h2>
      </div>
      <p class="fx-lede" data-in>In Tabs any agent can hand work to an agent from any other provider. So put your favourite in charge, then give each kind of work to the model that does it best.</p>
    </div>
    <div class="rl-machine" data-rl data-in>
      {roles.map((r, i) => (
        <div class:list={["rl-col", i === 0 && "rl-col--lead on-ink"]} data-rl-col data-pv={r.pv} data-verb={r.verb}>
          <p class="rl-job"><span>{String(i + 1).padStart(2, "0")}</span>{r.noun}</p>
          <p class="rl-pick">{r.pick}</p>
          <button type="button" class="rl-nudge" data-rl-step="-1" aria-label={`Previous agent for ${r.noun}`}><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 10l5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
          <div class="rl-win"><ul class="rl-strip" data-rl-strip></ul></div>
          <button type="button" class="rl-nudge" data-rl-step="1" aria-label={`Next agent for ${r.noun}`}><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        </div>
      ))}
      <div class="rl-foot">
        <button type="button" class="v1-btn" data-rl-spin>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M16.5 10a6.5 6.5 0 1 1-1.9-4.6M16.5 3.5v3.2h-3.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Spin the crew
        </button>
        <p class="rl-say" data-rl-say aria-live="polite"></p>
        <p class="rl-n"><b>7,529,536</b> possible crews, all on plans you already pay for.</p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .rl-machine { --h: 92px; display: grid; grid-template-columns: repeat(6, 1fr); margin-top: clamp(40px, 5vw, 72px); border-radius: 28px; background: var(--cream); box-shadow: inset 0 0 0 1px var(--line); overflow: hidden; }
  .rl-col { display: grid; grid-template-rows: auto 1fr auto auto auto; justify-items: center; padding: 24px 0 14px; border-left: 1px solid var(--line); }
  .rl-col--lead { background: var(--ink); color: var(--ivory); }
  .rl-col:first-child { border-left: 0; }
  .rl-job { display: grid; justify-items: center; gap: 10px; margin: 0; font-size: clamp(22px, 2.2vw, 32px); font-weight: 500; letter-spacing: -.03em; }
  .rl-job span { font: 500 11px var(--mono); letter-spacing: .12em; color: var(--mute); }
  .rl-pick { margin: 10px 0 12px; padding: 0 16px; max-width: 17em; font-size: 14px; line-height: 1.35; text-align: center; color: var(--mute); }
  .rl-col--lead .rl-job span, .rl-col--lead .rl-pick, .rl-col--lead .rl-nudge { color: rgba(243, 239, 233, .6); }
  .rl-col--lead .rl-nudge:hover { color: var(--ivory); }
  .rl-col--lead .rl-win::before, .rl-col--lead .rl-win::after { border-color: rgba(243, 239, 233, .25); }
  .rl-nudge { display: grid; place-items: center; width: 100%; height: 34px; border: 0; background: none; color: var(--mute); cursor: pointer; transition: color .2s, translate .3s cubic-bezier(.2, 1.6, .4, 1); }
  .rl-nudge:hover { color: var(--ink); }
  .rl-nudge[data-rl-step="-1"]:active { translate: 0 -3px; } .rl-nudge[data-rl-step="1"]:active { translate: 0 3px; }
  .rl-win { position: relative; width: 100%; height: calc(var(--h) * 3); overflow: hidden; cursor: pointer; -webkit-mask: linear-gradient(transparent, #000 34%, #000 66%, transparent); mask: linear-gradient(transparent, #000 34%, #000 66%, transparent); }
  .rl-win::before, .rl-win::after { content: ""; position: absolute; left: 14%; right: 14%; top: var(--h); border-top: 1px solid rgba(11, 13, 31, .16); z-index: 1; pointer-events: none; }
  .rl-win::after { top: calc(var(--h) * 2); }
  .rl-strip { margin: 0; padding: 0; list-style: none; will-change: transform; }
  .rl-strip li { display: grid; justify-items: center; align-content: center; gap: 10px; height: var(--h); font-size: clamp(14px, 1.3vw, 18px); font-weight: 500; letter-spacing: -.02em; white-space: nowrap; }
  /* The controls sit inside the machine, right under the reels, so the spin button is never off on its own. */
  .rl-foot { grid-column: 1 / -1; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 16px clamp(20px, 3vw, 40px); align-items: center; padding: clamp(18px, 2vw, 26px) clamp(18px, 2.4vw, 32px); border-top: 1px solid var(--line); background: #fff; }
  .rl-foot .v1-btn { height: 60px; padding: 0 30px 0 24px; font-size: 17px; white-space: nowrap; }
  .rl-foot .v1-btn svg { transition: rotate .7s cubic-bezier(.2, 1, .3, 1); }
  .rl-foot .v1-btn:hover svg { rotate: 180deg; }
  .rl-foot .v1-btn:active { scale: .97; }
  .rl-say { margin: 0; font-size: clamp(17px, 1.5vw, 22px); line-height: 1.35; letter-spacing: -.015em; color: var(--mute); }
  .rl-say b { font-weight: 500; color: var(--ink); }
  .rl-n { margin: 0; font-size: 14px; color: var(--mute); text-align: right; max-width: 15em; }
  .rl-n b { display: block; font: 400 clamp(30px, 3vw, 46px)/1 var(--serif); font-style: italic; letter-spacing: -.02em; color: var(--cobalt); }
  @media (max-width: 900px) {
    .rl-machine { --h: 78px; grid-template-columns: repeat(3, 1fr); }
    .rl-col:nth-child(4) { border-left: 0; } .rl-col:nth-child(n + 4) { border-top: 1px solid var(--line); }
    .rl-foot { grid-template-columns: 1fr; } .rl-foot .v1-btn { justify-content: center; width: 100%; } .rl-n { text-align: left; max-width: none; } .rl-pick { padding: 0 8px; font-size: 12px; } .rl-job { font-size: 20px; }
  }
</style>

<script>
  import { gsap } from "../../../../lib/lab/common";
  import { seen, providers, logo, reduced } from "../../../../lib/lab/fx";

  const list = providers();
  const names = new Map(list.map((p) => [p.id, p.name]));
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text = "") => Object.assign(document.createElement(tag), { textContent: text });

  /* One reel per job. A reel is 14 names long and wraps. */
  {
    const sec = document.querySelector<HTMLElement>(".rl")!;
    const cols = [...sec.querySelectorAll<HTMLElement>("[data-rl-col]")];
    const say = sec.querySelector<HTMLElement>("[data-rl-say]")!;
    const N = list.length;
    const mod = (k: number) => ((k % N) + N) % N;
    const reels = cols.map((col) => {
      const strip = col.querySelector<HTMLElement>("[data-rl-strip]")!;
      // Two spare names on each end so the wrap never shows a gap.
      for (let i = -2; i < N + 2; i++) {
        const p = list[mod(i)]!;
        const li = el("li");
        li.append(logo(p.id, 34), el("span", p.name));
        strip.append(li);
      }
      const state = { k: list.findIndex((p) => p.id === col.dataset.pv) };
      const h = () => strip.firstElementChild!.getBoundingClientRect().height || 92;
      const paint = () => { strip.style.transform = `translateY(${-(mod(state.k) + 1) * h()}px)`; };
      const go = (to: number, duration: number, ease = "power3.out") => {
        const done = () => { state.k = mod(Math.round(state.k)); col.dataset.pv = list[state.k]!.id; paint(); speak(); };
        if (reduced) { state.k = to; return done(); }
        gsap.to(state, { k: to, duration, ease, overwrite: true, onUpdate: paint, onComplete: done });
      };
      col.querySelectorAll<HTMLButtonElement>("[data-rl-step]").forEach((b) => b.addEventListener("click", () => go(Math.round(state.k) + Number(b.dataset.rlStep), 0.45)));
      col.querySelector(".rl-win")!.addEventListener("click", () => go(Math.round(state.k) + 1, 0.45));
      paint();
      return { state, go, paint };
    });
    function speak() {
      const parts = cols.map((c) => `<b>${names.get(c.dataset.pv!)}</b> ${c.dataset.verb}`);
      say.innerHTML = `${parts.slice(0, -1).join(", ")} and ${parts.at(-1)}.`;
    }
    sec.querySelector("[data-rl-spin]")!.addEventListener("click", () =>
      reels.forEach((r, i) => r.go(Math.round(r.state.k) + N * (1 + (i % 2)) + 1 + Math.floor(Math.random() * (N - 1)), 1.3 + i * 0.22, "power4.out")));
    new ResizeObserver(() => reels.forEach((r) => r.paint())).observe(sec.querySelector(".rl-machine")!);
    speak();
    seen(sec.querySelector(".rl-machine")!, () => reels.forEach((r, i) => r.go(r.state.k + N, 1.2 + i * 0.18, "power4.out")), 0.4);
  }
</script>
