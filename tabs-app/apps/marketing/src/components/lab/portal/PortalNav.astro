---
import Mark from "../Mark.astro";
import { links } from "../../../data/lab";
interface Props {
  current?: "home" | "changelog" | "downloads";
  home?: string;
}
const { current = "home", home = "/" } = Astro.props;
// Product, then updates, people, the extension marketplace and the source.
const items = [
  { label: "Inside Tabs", href: current === "home" ? "#portal" : `${home}#portal`, current: false, external: false },
  { label: "Changelog", href: links.changelog, current: current === "changelog", external: false },
  { label: "Community", href: links.community, current: false, external: false },
  { label: "Exchange", href: links.exchange, current: false, external: true },
  { label: "GitHub", href: links.github, current: false, external: true },
];
---
<div class="v1-cursor" aria-hidden="true"></div>
<header class="v1-nav">
  <div class="v1-nav__brand">
    <a href={home} class="v1-nav__logo" aria-label="Tabs IDE home"><Mark size={26} color="#0E2AF3" eyes="#FBFCFE" data-alive /><span class="v1-nav__word">Tabs</span></a>
    <span class="v1-nav__sep" aria-hidden="true"></span>
    <a class="v1-nav__beta" href="/changelog"><span>Public beta</span></a>
  </div>
  <nav aria-label="Primary" class="v1-nav__links">
    {items.map((it) => (
      <a href={it.href} aria-current={it.current ? "page" : undefined} {...(it.external ? { rel: "noopener" } : {})} {...(it.href === links.exchange ? { "data-exchange-departure": "" } : {})}>
        {it.label}{it.external && <span class="v1-nav__ext" aria-hidden="true">↗</span>}
      </a>
    ))}
  </nav>
  <div class="v1-nav__end">
    <a class="v1-btn v1-btn--sm" href={links.download} data-magnetic="0.3" aria-current={current === "downloads" ? "page" : undefined}><span>Download</span></a>
    <button type="button" class="v1-nav__menu" aria-expanded="false" aria-controls="v1-menu" aria-label="Menu"><i></i><i></i></button>
  </div>
</header>
<div class="v1-sheet" id="v1-menu" hidden>
  <nav aria-label="Menu" class="v1-sheet__links">
    {items.map((it, i) => (
      <a href={it.href} aria-current={it.current ? "page" : undefined} {...(it.external ? { rel: "noopener" } : {})} {...(it.href === links.exchange ? { "data-exchange-departure": "" } : {})}>
        <span class="v1-sheet__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <span class="v1-sheet__mask"><span class="v1-sheet__label">{it.label}{it.external && <span class="v1-sheet__ext" aria-hidden="true">↗</span>}</span></span>
      </a>
    ))}
  </nav>
  <div class="v1-sheet__foot">
    <a class="v1-btn v1-sheet__cta" href={links.download}><span>Download Tabs</span></a>
    <p class="v1-sheet__meta">Public beta · macOS · Windows · Linux</p>
  </div>
</div>

<script>
  import "../../../lib/exchange-departure";
  import { gsap, reduced, smoothScroll } from "../../../lib/lab/common";
  const btn = document.querySelector<HTMLButtonElement>(".v1-nav__menu");
  const sheet = document.querySelector<HTMLElement>(".v1-sheet");
  const nav = document.querySelector<HTMLElement>(".v1-nav");
  if (btn && sheet && nav) {
    const root = document.documentElement;
    const labels = sheet.querySelectorAll<HTMLElement>(".v1-sheet__label");
    const extras = sheet.querySelectorAll<HTMLElement>(".v1-sheet__num, .v1-sheet__links a, .v1-sheet__foot > *");
    const inerted: HTMLElement[] = [];
    let isOpen = false;

    // The sheet grows out of the hamburger button, like the Exchange reveal.
    const circle = (r: string) => {
      const b = btn.getBoundingClientRect();
      return `circle(${r} at ${b.left + b.width / 2}px ${b.top + b.height / 2}px)`;
    };
    const fullRadius = () => `${Math.hypot(innerWidth, innerHeight)}px`;

    const setBackgroundInert = (on: boolean) => {
      if (on) {
        // Everything except the nav and the sheet, at every level up to <body>.
        let branch: HTMLElement = nav;
        while (branch.parentElement) {
          const parent = branch.parentElement;
          for (const el of parent.children) {
            if (!(el instanceof HTMLElement) || el === branch || el === sheet || ["SCRIPT", "STYLE", "LINK"].includes(el.tagName) || el.inert) continue;
            el.inert = true;
            inerted.push(el);
          }
          if (parent === document.body) break;
          branch = parent;
        }
      } else {
        inerted.splice(0).forEach((el) => (el.inert = false));
      }
    };

    const toggle = (open: boolean, returnFocus = true) => {
      if (open === isOpen) return;
      isOpen = open;
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Menu");
      root.classList.toggle("v1-menu-open", open);
      nav.classList.remove("hide");
      setBackgroundInert(open);
      const lenis = smoothScroll();
      gsap.killTweensOf([sheet, labels, extras]);
      if (open) {
        lenis?.stop();
        sheet.hidden = false;
        if (reduced) {
          gsap.set(sheet, { clipPath: "none" });
        } else {
          gsap.fromTo(sheet, { clipPath: circle("0px") }, { clipPath: circle(fullRadius()), duration: 0.75, ease: "expo.inOut" });
          gsap.fromTo(labels, { yPercent: 110, rotate: 4 }, { yPercent: 0, rotate: 0, duration: 0.9, ease: "expo.out", stagger: 0.06, delay: 0.3 });
          gsap.fromTo(extras, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.6, ease: "power2.out", stagger: 0.03, delay: 0.42 });
        }
        sheet.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
      } else {
        lenis?.start();
        const done = () => { sheet.hidden = true; gsap.set([sheet, labels, extras], { clearProps: "all" }); };
        if (reduced) done();
        else {
          gsap.to(labels, { yPercent: -110, duration: 0.35, ease: "power3.in", stagger: 0.02 });
          gsap.to(sheet, { clipPath: circle("0px"), duration: 0.6, ease: "expo.inOut", delay: 0.12, onComplete: done });
        }
        if (returnFocus) btn.focus({ preventScroll: true });
      }
    };

    btn.addEventListener("click", () => toggle(!isOpen));
    sheet.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement).closest("a");
      // Exchange keeps the sheet up until its own departure reveal covers the page.
      if (link && !link.hasAttribute("data-exchange-departure")) toggle(false, false);
    });
    addEventListener("keydown", (e) => { if (e.key === "Escape" && isOpen) toggle(false); });
    matchMedia("(min-width: 961px)").addEventListener("change", (m) => { if (m.matches) toggle(false, false); });
    window.addEventListener("pageshow", () => toggle(false, false));
  }
</script>
