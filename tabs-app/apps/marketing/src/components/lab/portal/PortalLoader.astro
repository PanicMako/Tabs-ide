---
/**
 * Page loader: cobalt bands, the Tabs mark, the tools rolling by, then "Tabs.".
 * Plays in full on the first visit of a session, and as a short cover/reveal
 * when moving between pages (see `lib/lab/transition.ts`).
 */
import Mark from "../Mark.astro";
const words = ["Code", "Agents", "Dock", "Git", "Browser"];
---
<script is:inline>
  (() => {
    const root = document.documentElement;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let seen = false, via = false;
    try { seen = sessionStorage.getItem("tabs-loaded") === "1"; via = sessionStorage.getItem("tabs-transition") === "1"; sessionStorage.removeItem("tabs-transition"); } catch {}
    if (via) { root.dataset.loading = "1"; root.dataset.loader = "reveal"; }
    else if (!seen) { root.dataset.loading = "1"; root.dataset.loader = "full"; }
  })();
</script>

<div class="pl" aria-hidden="true">
  <div class="pl-bands">{Array.from({ length: 6 }, () => <i></i>)}</div>
  <div class="pl-center">
    <div class="pl-mark"><Mark size="100%" color="#FBFCFE" eyes="#0E2AF3" /></div>
    <div class="pl-word">{[...words, "Tabs."].map((w, i) => <span class:list={["pl-w", i === words.length && "pl-last"]}>{w}</span>)}</div>
  </div>
  <p class="pl-sub">One window for every project</p>
</div>

<style is:global>
  .pl { position: fixed; inset: 0; z-index: 1200; display: none; pointer-events: none; color: #fbfcfe; }
  html[data-loading="1"] .pl, .pl.is-on { display: grid; place-items: center; }
  html[data-loading="1"] body { overflow: hidden; }
  .pl-bands { position: absolute; inset: 0; display: grid; grid-template-rows: repeat(6, 1fr); }
  .pl-bands i { background: #0e2af3; will-change: transform; margin: -1px 0; }
  .pl-center { opacity: 0; position: relative; display: flex; align-items: center; gap: clamp(16px, 2.2vw, 36px); font-size: clamp(64px, 9vw, 160px); }
  .pl-mark { flex: none; width: .82em; margin-top: -.06em; }
  .pl-mark svg { width: 100%; height: auto; overflow: visible; }
  .pl-mark .lab-mark__body, .pl-mark .lab-mark__foot { transform-box: fill-box; }
  /* Words stack in one slot; the slot's width glides to fit each word, so mark and word stay centered together. */
  .pl-word { position: relative; height: 1.1em; width: 2.4em; overflow: hidden; font: 400 1em/1.1 "Instrument Serif", Georgia, serif; font-style: italic; letter-spacing: -.03em; will-change: width; }
  .pl-w { position: absolute; left: 0; top: 0; padding-right: .08em; white-space: nowrap; will-change: transform; }
  .pl-last { font-style: normal; font-family: "Inter Tight", system-ui, sans-serif; font-weight: 600; letter-spacing: -.06em; }
  .pl-sub { position: absolute; left: 0; right: 0; bottom: 40px; margin: 0; text-align: center; font: 500 12px "JetBrains Mono", monospace; text-transform: uppercase; letter-spacing: .12em; opacity: .75; }
</style>

<script>
  import { gsap } from "../../../lib/lab/common";
  import { setCover } from "../../../lib/lab/transition";
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>(".pl")!;
  const bands = gsap.utils.toArray<HTMLElement>(".pl-bands i");
  const word = document.querySelector<HTMLElement>(".pl-word")!;
  const ws = gsap.utils.toArray<HTMLElement>(".pl-w");
  const n = ws.length;
  const widthOf = (i: number) => ws[i]!.offsetWidth;
  // Put the roll back on its first word ("Code") with the slot sized to fit it.
  const reset = () => {
    ws.forEach((w, i) => gsap.set(w, { y: 0, yPercent: i ? 110 : 0 }));
    gsap.set(word, { width: widthOf(0) });
  };
  // Roll from word i-1 to word i, resizing the slot at the same pace.
  const step = (tl: gsap.core.Timeline, i: number, d: number, at: string) => {
    const ease = i === n - 1 ? "expo.out" : "power3.inOut";
    tl.to(ws[i - 1]!, { yPercent: -110, duration: d, ease }, at)
      .fromTo(ws[i]!, { yPercent: 110 }, { yPercent: 0, duration: d, ease }, "<")
      .to(word, { width: () => widthOf(i), duration: d, ease }, "<");
  };
  const rollAll = (tl: gsap.core.Timeline, fast: boolean) => {
    for (let i = 1; i < n; i++) step(tl, i, i === n - 1 ? (fast ? 0.5 : 0.7) : fast ? 0.22 : 0.3, i === 1 ? (fast ? "+=0.05" : "+=0.15") : fast ? "+=0.04" : "+=0.1");
    return tl;
  };
  document.fonts?.ready.then(() => { if (!el.classList.contains("is-on") && root.dataset.loader !== "full") reset(); });
  reset();
  const mark = ".pl-mark", eyes = ".pl-mark .lab-mark__eyes";

  // Let the page start its own intro the moment the bands begin to open, so it plays once, underneath.
  const ready = () => {
    if (root.dataset.loading !== "1") return;
    delete root.dataset.loading;
    try { sessionStorage.setItem("tabs-loaded", "1"); } catch {}
    window.dispatchEvent(new Event("lab:ready"));
  };
  const finish = () => { delete root.dataset.loader; el.classList.remove("is-on"); el.style.display = "none"; };
  const out = () =>
    gsap.timeline({ onStart: () => { el.style.display = "grid"; } })
      .to(".pl-center, .pl-sub", { autoAlpha: 0, y: -16, scale: 0.97, duration: 0.3, ease: "power2.in" })
      .call(ready, [], 0.18)
      .to(bands, { xPercent: (i) => (i % 2 ? 101 : -101), duration: 0.85, ease: "expo.inOut", stagger: 0.05 }, "<0.08")
      .add(finish);

  if (root.dataset.loader === "full") {
    const tl = gsap.timeline()
      .set(".pl-center", { opacity: 1 })
      .from(`${mark} .lab-mark__body`, { y: -60, scaleY: 1.25, autoAlpha: 0, duration: 0.5, ease: "power3.in" })
      .to(mark, { scaleY: 0.8, scaleX: 1.15, transformOrigin: "50% 100%", duration: 0.09 })
      .to(mark, { scaleY: 1, scaleX: 1, duration: 0.6, ease: "elastic.out(1.1,0.4)" })
      .from(`${mark} .lab-mark__foot`, { x: -50, rotate: -30, autoAlpha: 0, transformOrigin: "50% 50%", duration: 0.55, ease: "back.out(1.8)" }, 0.35)
      .from(".pl-word", { yPercent: 40, autoAlpha: 0, duration: 0.6, ease: "expo.out" }, 0.3)
      .from(".pl-sub", { autoAlpha: 0, duration: 0.6 }, 0.4);
    rollAll(tl, false);
    tl.to(eyes, { scaleY: 0.1, transformOrigin: "50% 50%", duration: 0.07, yoyo: true, repeat: 1, ease: "none" }, "-=0.3")
      .add(out(), "+=0.3");
  } else if (root.dataset.loader === "reveal") {
    // Arriving from another page: the bands are closed on "Code"; roll through to "Tabs.", then open.
    const tl = gsap.timeline().fromTo(".pl-center", { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.3, ease: "power2.out" });
    rollAll(tl, true).add(out(), "+=0.2");
  }

  // After a download flourish, open the bands again.
  window.addEventListener("tabs:reveal", () => { rollAll(gsap.timeline(), true).add(out(), "+=0.15"); });

  // Cover the screen before leaving for another page.
  setCover(() =>
    new Promise<void>((resolve) => {
      el.style.display = "grid";
      el.classList.add("is-on");
      reset();
      gsap.set(".pl-center", { opacity: 0, autoAlpha: 0, y: 16, scale: 1 });
      gsap.set(".pl-sub", { autoAlpha: 0, y: 16, scale: 1 });
      gsap.timeline({ onComplete: resolve })
        .fromTo(bands, { xPercent: (i) => (i % 2 ? 101 : -101) }, { xPercent: 0, duration: 0.6, ease: "expo.inOut", stagger: 0.04 })
        .to(".pl-center, .pl-sub", { autoAlpha: 1, y: 0, duration: 0.3, ease: "power2.out" }, "-=0.2");
    }),
  );
</script>
