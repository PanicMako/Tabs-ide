        const dy = pc.y - gv.y;
        const dd = Math.hypot(dx, dy) || 1;
        const st = Math.min(dd, (hunting ? 26 : 44) * dt);
        gv.x += (dx / dd) * st;
        gv.y += (dy / dd) * st;
      }
    }

    const live = ptr.inside;
    if (hunting && hunt) hand = { x: hunt.p.x, y: hunt.p.y };
    else hand = { x: gv.x, y: gv.y };

    stage.style.cursor = ptr.inside ? 'none' : '';

    anchor = hunting
      ? { x: hand.x, y: hand.y }
      : { x: hand.x + (16 - HX) * sc, y: hand.y + (18 - HY) * sc };
    near = nearest(anchor.x, anchor.y);
    const D = Math.max(0, near.dist);
    const dk = ptr.touch ? Math.max(0.55, Math.min(1, w / 560)) : 1;
    const sn = sense * dk;

    const cx = pill.x + pill.w / 2;
    lean += ((live ? Math.max(-1, Math.min(1, (hand.x - cx) / (pill.w * 1.5))) : 0) - lean) * Math.min(1, dt * 4);

    if (hunting && hunt) {
      if (mode === 'idle') {
        grips = grips;
        spawn();
      }
      hunt.t = (hunt.t || 0) + dt;
      if (mode === 'seek' && hunt.t > 0.9) {
        mode = 'grow';
        grow = 0;
      }
      if (mode === 'snap' && hunt.t > 0.2) mode = 'seek';
    } else {
      if (mode === 'idle' && live && D < sn && !queue.length) {
        grips = GRIPS;
        spawn();
      } else if (mode === 'snap' && !violent && live && D < sn && !queue.length) {
        mode = 'seek';
      } else if (mode === 'seek' && (!live || D > sn + 25)) {
        snap(false);
      } else if (mode === 'seek' && D < reach) {
        mode = 'grow';
        grow = 0;
      } else if ((mode === 'grow' || mode === 'hold') && (!live || D > release)) {
        snap(true);
      }
    }

    const holding = mode === 'hold' || mode === 'grow';
    const seeking = mode === 'seek';
    const fT = seeking ? Math.max(0, Math.min(1, hunting ? 0.7 : (sn - D) / Math.max(1, sn - reach))) : holding ? 1 : 0;
    seekF += (fT - seekF) * Math.min(1, dt * 5);
    stretch = holding ? Math.min(1, D / release) : 0;

    if (mode === 'grow') {
      grow = Math.min(1, grow + dt / 0.3);
      if (grow >= 1) mode = 'hold';
    }

    // reel caught window into body
    if (hunting && holding && hunt) {
      hold += dt;
      const c = { x: pill.x + pill.w / 2, y: pill.y + pill.h / 2 };
      const dx = c.x - hunt.p.x;
      const dy = c.y - hunt.p.y;
      const dd = Math.hypot(dx, dy) || 1;
      const sp = Math.min(dd, (110 + hold * 320) * dt);
      hunt.p.x += (dx / dd) * sp;
      hunt.p.y += (dy / dd) * sp;
      hunt.s = Math.max(0.12, Math.min(1, (near.dist - 8) / 160));
      hunt.q = Math.max(0, 1 - hunt.s);
      hunt.ang = Math.atan2(dy, dx);
      place(hunt);

      if (stage.dataset.v !== '2') {
        stage.style.setProperty('--ix', hunt.p.x + 'px');
        stage.style.setProperty('--iy', hunt.p.y + 'px');
      }

      if (near.dist < 14) {
        hunt.gone = 1;
        place(hunt);
        taken++;
        setCnt();
        snap(true);
        moundV -= 140;
        if (stage.dataset.v === '3') {
          stage.style.setProperty('--ix', hunt.p.x + 'px');
          stage.style.setProperty('--iy', hunt.p.y + 'px');
        }
        gulp();
        if (sayEl) {
          sayEl.textContent = hunt.say;
          sayEl.classList.remove('on');
          void sayEl.offsetWidth;
          sayEl.classList.add('on');
        }
        btn.classList.remove('gulp');
        void btn.offsetWidth;
        btn.classList.add('gulp');
        hunt = null;
        grips = GRIPS;
      }
    }

    const dT = WINS.length ? (taken + (hunting && holding ? Math.min(1, hold / 2) * 0.9 : 0)) / WINS.length : 0;
    dv += (dT - dv) * Math.min(1, dt * 1.6);
    stage.style.setProperty('--d', dv.toFixed(3));

    {
      const T = ptr.inside && gv ? gv : pc;
      WINS.forEach(o => {
        if (o.gone) return;
        o.el.classList.toggle('sc', o === hunt);
        o.el.classList.toggle('nr', ptr.inside && !hunting && gv !== null && Math.hypot(gv.x - o.p.x, gv.y - o.p.y) < o.el.offsetWidth * 0.5 + 120);
        if (o.ey) {
          const dx = T.x - o.p.x;
          const dy = T.y - o.p.y;
          const d = Math.hypot(dx, dy) || 1;
          o.ey.style.translate = (dx / d * 4) + 'px ' + (dy / d * 3) + 'px';
        }
      });
    }

    const spreadPx = Math.max(14, Math.min(pill.w * 0.3, D * 0.4 + 14)) * (seeking ? 0.65 : 1);
    let alive = 0;

    for (const st of list) {
      const target = near.s + st.spread * spreadPx;
      st.s += loopDiff(st.s, target) * Math.min(1, dt * (mode === 'snap' ? 1.5 : 6));
      const root = at(st.s);
      const rx = root.x - root.nx * 3;
      const ry = root.y - root.ny * 3;
      let pin = false;
      const gp = gripAt(st.grip);

      if (seeking) {
        const vx = gp.x - rx;
        const vy = gp.y - ry;
        const vl = Math.hypot(vx, vy) || 1;
        const ease = seekF * seekF * (3 - 2 * seekF);
        const dart = Math.pow(Math.max(0, Math.sin(time * 1.9 + st.phase * 3.1)), 10) * 0.28;
        const len = Math.max(3, vl * st.reachK * 0.85 * ease * (1 + dart));
        const sway = Math.sin(time * 2.7 + st.phase) * (3 + 9 * ease) + Math.sin(time * 5.3 + st.phase * 2) * 2 * ease;
        const tx = rx + (vx / vl) * len - (vy / vl) * sway;
        const ty = ry + (vy / vl) * len + (vx / vl) * sway;
        const k = 1 - Math.exp(-dt * 6);
        st.ex += (tx - st.ex) * k;
        st.ey += (ty - st.ey) * k;
        pin = true;
        st.seg = Math.hypot(st.ex - rx, st.ey - ry) * (st.slack + 0.06) / (NP - 1);
      } else if (holding) {
        let gx = gp.x;
        let gy = gp.y;
        if (mode === 'grow') {
          const coil = Math.pow(1 - grow, 1.6) * 13;
          const a = st.phase + grow * Math.PI * 2.6;
          gx += Math.cos(a) * coil;
          gy += Math.sin(a) * coil * 0.8;
        }
        const k = 1 - Math.exp(-dt * (mode === 'grow' ? 20 + st.follow : st.follow * 1.4));
        st.ex += (gx - st.ex) * k;
        st.ey += (gy - st.ey) * k;
        pin = true;
        st.seg = Math.hypot(st.ex - rx, st.ey - ry) * st.slack / (NP - 1);
      } else {
        st.seg *= Math.exp(-dt * 5.5);
        if (st.seg * (NP - 1) > 1.5) alive++;
      }

      const damp = mode === 'snap' ? 0.86 : 0.92;
      for (let i = 1; i < NP; i++) {
        const vx = (st.x[i] - st.px[i]) * damp;
        const vy = (st.y[i] - st.py[i]) * damp;
        st.px[i] = st.x[i];
        st.py[i] = st.y[i];
        const mid = Math.sin(i / (NP - 1) * Math.PI);
        const wx = Math.sin(time * 1.6 + st.phase + i * 0.55) * 14 * mid;
        const wy = Math.cos(time * 1.3 + st.phase * 1.3 + i * 0.45) * 14 * mid;
        st.x[i] += vx + wx * dt * dt;
        st.y[i] += vy + (260 + wy) * dt * dt;
      }
      st.x[0] = st.px[0] = rx;
      st.y[0] = st.py[0] = ry;
      if (pin) {
        st.x[NP - 1] = st.ex;
        st.y[NP - 1] = st.ey;
      }

      const len = Math.max(0.01, st.seg);
      for (let it = 0; it < 14; it++) {
        for (let i = 0; i < NP - 1; i++) {
          const dx = st.x[i + 1] - st.x[i];
          const dy = st.y[i + 1] - st.y[i];
          const d = Math.hypot(dx, dy) || 1e-4;
          const df = (d - len) / d;
          const a = i === 0 ? 0 : 0.5;
          const b = pin && i + 1 === NP - 1 ? 0 : i === 0 ? 1 : 0.5;
          const m = a + b || 1;
          st.x[i] += dx * df * (a / m);
          st.y[i] += dy * df * (a / m);
          st.x[i + 1] -= dx * df * (b / m);
          st.y[i + 1] -= dy * df * (b / m);
        }
      }

      for (let ps = 0; ps < 2; ps++) {
        for (let i = 1; i < NP - 1; i++) {
          st.x[i] += ((st.x[i - 1] + st.x[i + 1]) / 2 - st.x[i]) * 0.22;
          st.y[i] += ((st.y[i - 1] + st.y[i + 1]) / 2 - st.y[i]) * 0.22;
        }
      }

      if (!Number.isFinite(st.x[NP - 1])) {
        st.x.fill(rx);
        st.y.fill(ry);
        st.px.fill(rx);
        st.py.fill(ry);
      }
    }

    if (mode === 'snap' && alive === 0) {
      mode = 'idle';
      list = [];
    }

    const mT = holding ? 5 + 16 * stretch : seeking ? 3 + 9 * seekF : 0;
    moundV += ((mT - mound) * 150 - moundV * 9) * dt;
    mound += moundV * dt;

    if (holding || seeking) {
      moundS += loopDiff(moundS, near.s) * Math.min(1, dt * 6);
      const e = at(moundS);
      const tx = anchor.x - e.x;
      const ty = anchor.y - e.y;
      const tl = Math.hypot(tx, ty) || 1;
      moundDir = { x: e.nx * 0.55 + (tx / tl) * 0.45, y: e.ny * 0.55 + (ty / tl) * 0.45 };
    }

    for (let k = spikes.length - 1; k >= 0; k--) {
      spikes[k].age += dt;
      if (spikes[k].age > spikes[k].life) spikes.splice(k, 1);
    }

    for (let k = drops.length - 1; k >= 0; k--) {
      const d = drops[k];
      d.age += dt;
      d.vy += 520 * dt;
      d.vx *= Math.exp(-dt * 2);
      d.vy *= Math.exp(-dt);
      d.x += d.vx * dt;
      d.y += d.vy * dt;
      d.r *= Math.exp(-dt * 1.5);
      if (d.age > 0.9 || nearest(d.x, d.y).dist < -d.r) drops.splice(k, 1);
    }

    const thin = 1 - 0.5 * stretch;
    const g2 = seeking ? 0.55 + 0.45 * seekF : 1;
    let minX = pill.x;
    let minY = pill.y;
    let maxX = pill.x + pill.w;
    let maxY = pill.y + pill.h;

    list.forEach((st, si) => {
      for (let i = 0; i < NP; i++) {
        const f = i / (NP - 1);
        let r = st.width * (3 - 1.9 * f) * thin * g2;
        if (holding) r *= 1 + 0.24 * Math.sin(f * 9 - time * 6 + st.phase) * Math.sin(f * Math.PI);
        if (mode === 'snap') r *= 1.15;
        const o = (si * NP + i) * 4;
        pts[o] = st.x[i];
        pts[o + 1] = st.y[i];
        pts[o + 2] = Math.max(0.55, r);
        pts[o + 3] = 1;
        minX = Math.min(minX, st.x[i]);
        maxX = Math.max(maxX, st.x[i]);
        minY = Math.min(minY, st.y[i]);
        maxY = Math.max(maxY, st.y[i]);
      }
    });

    spk.fill(0);
    spkR.fill(0);

    spikes.forEach((sp, k) => {
      const p = sp.age / sp.life;
      const u = p < 0.15 ? 1 - Math.pow(1 - p / 0.15, 3) : p > 0.45 ? Math.max(0, 1 - (p - 0.45) / 0.55) : 1;
      const len = sp.len * (p > 0.45 ? u * u * (3 - 2 * u) : u);
      const b = at(sp.s);
      const ang = Math.atan2(b.ny, b.nx) + sp.tilt + Math.sin(sp.age * 14) * Math.exp(-sp.age * 3) * 0.35;
      const tx = b.x + Math.cos(ang) * len;
      const ty = b.y + Math.sin(ang) * len;
      spk[k * 4] = b.x - b.nx * 2;
      spk[k * 4 + 1] = b.y - b.ny * 2;
      spk[k * 4 + 2] = tx;
      spk[k * 4 + 3] = ty;
      spkR[k * 4] = 2.6 * Math.min(1, u + 0.2);
      spkR[k * 4 + 1] = len > 0.6 ? 1 : 0;
      minX = Math.min(minX, tx);
      maxX = Math.max(maxX, tx);
      minY = Math.min(minY, ty);
      maxY = Math.max(maxY, ty);
    });

    drp.fill(0);
    drops.forEach((d, k) => {
      drp[k * 4] = d.x;
      drp[k * 4 + 1] = d.y;
      drp[k * 4 + 2] = d.r;
      drp[k * 4 + 3] = 1;
      minX = Math.min(minX, d.x);
      maxX = Math.max(maxX, d.x);
      minY = Math.min(minY, d.y);
      maxY = Math.max(maxY, d.y);
    });

    const me = at(moundS);
    const ml = Math.max(0, mound);
    const mr = ml > 0.3 ? (9 + spreadPx * 0.32) * Math.min(1, ml / 6) : 0;

    gl.clearColor(0, 0, 0, 0);
    gl.clear(gl.COLOR_BUFFER_BIT);
    gl.uniform2f(U.uRes!, glc.width, glc.height);
    gl.uniform1f(U.uDpr!, dpr);
    gl.uniform4f(U.uPill!, pill.x, pill.y, pill.w, pill.h);
    gl.uniform4fv(U.uPts!, pts);
    gl.uniform1f(U.uCount!, list.length);
    gl.uniform4fv(U.uSpk!, spk);
    gl.uniform4fv(U.uSpkR!, spkR);
    gl.uniform4fv(U.uDrop!, drp);
    gl.uniform4f(U.uMound!, me.x - me.nx * 6, me.y - me.ny * 6, me.x + moundDir.x * ml, me.y + moundDir.y * ml);
    gl.uniform2f(U.uMoundR!, mr, mr * 0.45);
    gl.uniform1f(U.uLean!, lean);
    gl.uniform1f(U.uDark!, dv);

    const pr = Number(stage.dataset.p || 3);
    const sm = (a: number, b: number, x: number) => {
      const t = Math.max(0, Math.min(1, (x - a) / (b - a)));
      return t * t * (3 - 2 * t);
    };
    const inv = pr === 2 ? sm(0.2, 0.7, dv) : 0;
    const halo = pr === 3 ? sm(0.15, 0.5, dv) : 0;
    gl.uniform1f(U.uInv!, inv);
    gl.uniform1f(U.uHalo!, halo);
    stage.style.setProperty('--inv', inv.toFixed(3));

    const pad = 34;
    const x0 = Math.max(0, minX - pad);
    const x1 = Math.min(w, maxX + pad);
    const y0 = Math.max(0, minY - pad);
    const y1 = Math.min(h, maxY + pad + 10);
    const X = (v: number) => (v / w) * 2 - 1;
    const Y = (v: number) => 1 - (v / h) * 2;
    quadD.set([X(x0), Y(y0), X(x1), Y(y0), X(x0), Y(y1), X(x1), Y(y1)]);
    gl.bufferData(gl.ARRAY_BUFFER, quadD, gl.DYNAMIC_DRAW);
    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

    // Cartoon glove canvas
    hx.setTransform(dpr, 0, 0, dpr, 0, 0);
    hx.clearRect(0, 0, w, h);

    if (ptr.inside) {
      hx.save();
      hx.translate(gv.x - HX * sc, gv.y - HY * sc);
      hx.scale(sc, sc);
      hx.save();
      hx.translate(2.5, 4.5);
      hx.fillStyle = 'rgba(0,0,0,.15)';
      hx.fill(gP);
      hx.fill(cP);
      hx.restore();
      hx.fillStyle = '#fff';
      hx.fill(cP);
      hx.fill(gP);
      hx.strokeStyle = '#0b0b0b';
      hx.lineWidth = 1.9;
      hx.stroke(cP);
      hx.lineWidth = 1.1;
      hx.stroke(cLn);
      hx.lineWidth = 1.9;
      hx.stroke(gP);
      hx.lineWidth = 1.1;
      hx.stroke(gLn);
      hx.restore();
    }

    if (holding && !hunting) {
      hx.lineCap = 'round';
      hx.strokeStyle = inv > 0.5 ? '#efeae0' : '#060607';
      for (const st of list) {
        const gp = gripAt(st.grip);
        const on = Math.max(0, Math.min(1, 1 - Math.hypot(st.ex - gp.x, st.ey - gp.y) / 14));
        if (on <= 0) continue;
        hx.globalAlpha = on;
        for (let i = NP - 4; i < NP - 1; i++) {
          const f = i / (NP - 1);
          hx.lineWidth = Math.max(0.6, st.width * (3 - 1.9 * f) * thin * 2);
          hx.beginPath();
          hx.moveTo(i === NP - 4 ? st.x[i] : (st.x[i - 1] + st.x[i]) / 2, i === NP - 4 ? st.y[i] : (st.y[i - 1] + st.y[i]) / 2);
          hx.quadraticCurveTo(st.x[i], st.y[i], i === NP - 2 ? st.x[NP - 1] : (st.x[i] + st.x[i + 1]) / 2, i === NP - 2 ? st.y[NP - 1] : (st.y[i] + st.y[i + 1]) / 2);
          hx.stroke();
        }
        hx.globalAlpha = 1;
      }
    }
  }

  const frame = (n: number) => {
    raf = visible ? requestAnimationFrame(frame) : 0;
    if (visible) draw(n);
  };

  new ResizeObserver(fit).observe(stage);
  fit();
  build(3);

  if (!reduced) {
    raf = requestAnimationFrame(frame);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !raf) {
        prev = performance.now();
        raf = requestAnimationFrame(frame);
      }
    }).observe(stage);
  } else {
    draw(performance.now());
  }
})();
</script>
