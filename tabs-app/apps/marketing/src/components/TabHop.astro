---
// TabHop - Peepers arcade game & legal footer
---
<section class="peepers-wrapper" id="peepers-arcade" aria-labelledby="peepers-heading">
  <div class="peepers-pacing" data-peepers-pacing>
    <div class="peepers-pin-stage">
      <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <symbol id="m" viewBox="0 0 390 390">
          <g fill="var(--b,#F3EFE9)">
            <path d="M 61 8 C 39 8 21 26 21 48 L 21 168 C 21 205 48 230 83 230 L 180 230 C 195 230 205 242 205 257 L 205 331 C 205 358 225 378 253 378 L 360 378 C 375 378 385 366 385 351 L 385 330 C 385 317 375 312 365 310 C 353 308 347 300 347 285 L 347 224 C 347 193 325 171 297 171 L 216 171 C 201 171 191 161 191 146 L 191 48 C 191 25 172 8 149 8 Z"/>
            <path d="M 60 251 L 185 251 L 185 318 C 185 353 165 379 132 379 L 26 379 C 12 379 2 367 2 354 L 2 306 C 2 275 26 251 60 251 Z"/>
          </g>
          <g class="m-eyes" fill="var(--e,#0E2AF3)">
            <rect x="65" y="108" width="23" height="56" rx="11.5" stroke="#0018d4" stroke-width="1.5"/>
            <rect x="126" y="108" width="23" height="56" rx="11.5" stroke="#0018d4" stroke-width="1.5"/>
          </g>
        </symbol>
      </svg>

      <div id="stage" data-v="2" data-p="3">
        <div id="edge"></div>
        <div id="ink"></div>
        <canvas id="gl" aria-hidden="true"></canvas>
        <button id="btn" type="button" aria-label="TABS. Click a window, or wave a hand near me.">
          <svg aria-hidden="true"><use href="#m"/></svg>
        </button>
        <canvas id="hand" aria-hidden="true"></canvas>
        <header class="hud">
          <b>
            <svg aria-hidden="true"><use href="#m"/></svg>
            TABS
          </b>
          <span id="peepers-heading">Slide your hand toward a window. When it gets a dashed halo, the venom is coming for it. Tap works too.</span>
        </header>
        <div id="cnt" aria-live="polite">0 / 6 windows folded into TABS</div>
        <div id="say" aria-hidden="true"></div>
        <div id="ov" role="dialog" aria-label="Finale"></div>
        <div id="toast" role="status"></div>
      </div>
    </div>
  </div>

  <footer class="peepers-legal">
    <span>© 2026 Tabs IDE. All rights reserved.</span>
    <a href="https://github.com/PanicMako/Tabs-ide" target="_blank" rel="noopener noreferrer">Built in the open ↗</a>
  </footer>
</section>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@500&family=Syne:wght@800&display=swap');

.peepers-wrapper {
  --ink: #0a0a0c;
  --ivory: #F3EFE9;
  --cobalt: #0E2AF3;
  display: block;
  position: relative;
  width: 100%;
}

.peepers-pacing {
  position: relative;
  min-height: calc(100vh + 65svh);
}

.peepers-pin-stage {
  position: sticky;
  top: 0;
  width: 100%;
  height: 100vh;
  height: 100svh;
  overflow: hidden;
  z-index: 2;
}

#stage {
  --fg: color-mix(in srgb, #efebe3 calc(var(--d, 0) * 100%), #14141a);
  --fgm: color-mix(in srgb, #e8e4dc calc(clamp(0.0, var(--d, 0) * 3.0, 1.0) * 100%), #2b303c);
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
  font-family: "DM Mono", ui-monospace, monospace;
  color: var(--fg);
  background: linear-gradient(180deg, #f5f4f6 0%, #efeef1 55%, #e4e3e6 100%);
}

@media (max-width: 700px), (prefers-reduced-motion: reduce) {
  .peepers-pacing {
    min-height: 100vh;
  }
  .peepers-pin-stage {
    position: relative;
    top: auto;
  }
}

#stage canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

#gl { z-index: 10; }
#hand { z-index: 30; }

.hud {
  position: absolute;
  z-index: 40;
  top: 20px;
  left: 24px;
  right: 24px;
  display: flex;
  justify-content: space-between;
  gap: 16px;
  font-size: 12px;
  line-height: 1.5;
  pointer-events: none;
}

.hud b {
  display: flex;
  align-items: center;
  gap: 8px;
  font: 800 17px 'Syne', system-ui, sans-serif;
  letter-spacing: -0.03em;
  color: var(--fg);
  transition: color 0.35s ease;
}

.hud svg {
  width: 28px;
  height: 28px;
  background: var(--cobalt);
  border-radius: 8px;
  padding: 3px;
  box-sizing: border-box;
}

.hud span {
  max-width: 340px;
  text-align: right;
  font-family: 'DM Mono', monospace;
  font-size: 11.5px;
  line-height: 1.55;
  color: var(--fgm);
  letter-spacing: 0.02em;
  transition: color 0.35s ease;
}

#btn {
  position: absolute;
  z-index: 20;
  left: 50%;
  top: 50%;
  width: 200px;
  height: 96px;
  margin: -48px 0 0 -100px;
  border: 0;
  border-radius: 99px;
  background: transparent;
  display: grid;
  place-items: center;
  outline: none;
  cursor: pointer;
  transition: transform 0.2s cubic-bezier(0.3, 1.6, 0.5, 1);
}

#btn:active { transform: scale(0.96); }
#btn:focus-visible { box-shadow: 0 0 0 4px rgba(14, 42, 243, 0.4); }

#btn svg {
  width: 60px;
  height: 60px;
  --b: #F3EFE9;
  --e: #0E2AF3;
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.45));
}

#btn svg .m-eyes {
  fill: #0E2AF3 !important;
  transform-box: fill-box;
  transform-origin: center;
  animation: peepers-mascot-blink 4s ease-in-out infinite;
}

@keyframes peepers-mascot-blink {
  0%, 93%, 100% { transform: scaleY(1); }
  96% { transform: scaleY(0.12); }
}

.fb #btn {
  background: linear-gradient(180deg, #1c1c1e, #0a0a0a 42%, #020202);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), 0 18px 28px -14px rgba(0, 0, 0, 0.55);
}

#ink, #edge {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  clip-path: circle(calc(var(--d, 0) * 145%) at var(--ix, 50%) var(--iy, 50%));
}

#ink {
  background: radial-gradient(1.2px 1.2px at 7px 7px, rgba(243, 239, 233, 0.1) 98%, transparent) 0 0/16px 16px,
              radial-gradient(120% 90% at 50% 38%, #2c2924, #11100e);
}

#edge {
  z-index: 0;
  background: #e8e2d4;
  clip-path: circle(calc((var(--d, 0) + 0.02) * 145%) at var(--ix, 50%) var(--iy, 50%));
  opacity: min(calc(var(--d, 0) * 40), 1);
}

#stage[data-v="2"] #ink {
  clip-path: inset(0 0 calc((1 - var(--d, 0)) * 100%) 0 round 0 0 46% 46% / 0 0 14% 14%);
}

#stage[data-v="2"] #edge {
  clip-path: inset(0 0 max(0%, calc((1 - var(--d, 0) - 0.025) * 100%)) 0 round 0 0 46% 46% / 0 0 14% 14%);
}

:global(.win) {
  position: absolute;
  z-index: 5;
  padding: 0;
  border: 0;
  background: none;
  text-align: left;
  font: inherit;
  color: inherit;
  cursor: pointer;
  will-change: transform;
}

:global(.win:focus-visible) {
  outline: 3px solid var(--cobalt);
  outline-offset: 4px;
  border-radius: 14px;
}

:global(.win.sc .in) {
  animation: peepers-shake 0.09s infinite alternate !important;
}

@keyframes peepers-bob {
  to { transform: translateY(-9px) rotate(0.7deg); }
}

@keyframes peepers-shake {
  from { translate: -3px 0; }
  to { translate: 3px 0; }
}

@keyframes peepers-blink {
  0%, 94%, 100% { transform: scaleY(1); }
  97% { transform: scaleY(0.1); }
}

@keyframes peepers-gulp {
  40% { transform: scale(1.12, 0.9); }
}

#btn.gulp {
  animation: peepers-gulp 0.35s;
}

:global(.in) {
  position: relative;
}

:global(.in::after) {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: #050507;
  opacity: var(--bk, 0);
  pointer-events: none;
}

:global(.in > *) {
  opacity: calc(1 - var(--bk, 0) * 1.5);
}

:global(.win.nr) {
  outline: 2px dashed color-mix(in srgb, #e8e2d4 calc(var(--d, 0) * 100%), #0E2AF3);
  outline-offset: 8px;
  border-radius: 20px;
}

:global(.win.nr .in) {
  translate: 0 -5px;
}

#stage[data-v="2"] :global(.win) {
  width: 146px;
}

#stage[data-v="2"] :global(.in) {
  display: block;
  background: var(--c);
  border: 3px solid #14141a;
  border-radius: var(--br, 24px 24px 14px 14px);
  padding: 14px 10px 10px;
  text-align: center;
  box-shadow: 5px 5px 0 color-mix(in srgb, #F3EFE9 calc(var(--d, 0) * 100%), #14141a);
  animation: peepers-bob 3s ease-in-out infinite alternate;
  rotate: var(--rt);
}

#stage[data-v="2"] :global(.ey) {
  display: flex;
  justify-content: center;
  gap: 12px;
  height: 36px;
  align-items: center;
}

#stage[data-v="2"] :global(.ey u) {
  width: 15px;
  height: 34px;
  border-radius: 9px;
  background: #14141a;
  animation: peepers-blink 4s infinite;
  transition: height 0.15s;
}

#stage[data-v="2"] :global(.sc .ey u) {
  height: 42px;
}

#stage[data-v="2"] :global(.in strong) {
  display: block;
  font: 800 15px/1.2 'Syne', -apple-system, BlinkMacSystemFont, sans-serif;
  color: #14141a;
  letter-spacing: -0.025em;
  margin-top: 6px;
}

#stage[data-v="2"] :global(.in small) {
  display: block;
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  font-weight: 500;
  color: #14141a;
  opacity: 0.75;
  margin-top: 3px;
  letter-spacing: 0.02em;
}

#say {
  position: absolute;
  z-index: 45;
  left: 50%;
  top: calc(50% - 100px);
  transform: translateX(-50%);
  font: 800 clamp(18px, 2.4vw, 24px) 'Syne', -apple-system, sans-serif;
  color: var(--fg);
  letter-spacing: -0.025em;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4), 0 0 1px rgba(0, 0, 0, 0.2);
  pointer-events: none;
  opacity: 0;
  white-space: nowrap;
}

#say.on {
  animation: peepers-say 1.4s ease-out;
}

@keyframes peepers-say {
  0% { opacity: 0; translate: 0 12px; scale: 0.96; }
  15% { opacity: 1; scale: 1; }
  85% { opacity: 1; scale: 1; }
  100% { opacity: 0; translate: 0 -36px; scale: 1.02; }
}

#cnt {
  position: absolute;
  z-index: 40;
  left: 22px;
  bottom: 22px;
  font-size: 12px;
  letter-spacing: 0.06em;
  pointer-events: none;
  color: var(--fgm);
}

#toast {
  position: absolute;
  z-index: 70;
  left: 50%;
  bottom: 76px;
  translate: -50% 12px;
  opacity: 0;
  max-width: 90vw;
  padding: 10px 16px;
  border-radius: 99px;
  background: #F3EFE9;
  color: #14130f;
  font-size: 12px;
  transition: 0.3s;
  pointer-events: none;
  text-align: center;
}

#toast.on {
  opacity: 1;
  translate: -50% 0;
}

#ov {
  position: absolute;
  inset: 0;
  z-index: 50;
  display: none;
  place-items: center;
  align-content: center;
  text-align: center;
  background: radial-gradient(80% 60% at 50% 18%, rgba(74, 68, 58, 0.55), rgba(12, 11, 9, 0.94));
  color: var(--ivory);
  backdrop-filter: blur(10px);
  overflow: auto;
}

#ov.on {
  display: grid;
}

:global(#ov .st) {
  display: grid;
  justify-items: center;
  gap: 14px;
  padding: clamp(20px, 5vh, 56px) 16px 50px;
  margin: auto;
  text-align: center;
  max-width: 94vw;
}

/* Receipt Finale (Version 2) */
:global(.rc .paper) {
  width: min(340px, 88vw);
  background: #f4f0e6;
  color: #1a1814;
  font: 500 12px/1.75 "DM Mono", monospace;
  padding: 24px 22px 34px;
  text-align: left;
  box-shadow: 0 40px 70px -24px #000;
  transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) rotate(-1.5deg);
  transition: transform 0.2s;
  animation: peepers-print 1.4s steps(16) both;
  -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50%/18px 100%;
  mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50%/18px 100%;
}

@keyframes peepers-print {
  from { clip-path: inset(0 0 100% 0); }
  to { clip-path: inset(0); }
}

:global(.rc h3) {
  margin: 0 0 4px;
  font: 800 20px 'Syne', sans-serif;
  letter-spacing: -0.03em;
  text-align: center;
  color: #1a1814;
}

:global(.rc .c) {
  text-align: center;
  color: #6d675b;
  font-size: 11px;
}

:global(.rc hr) {
  border: 0;
  border-top: 1.5px dashed #1a1814;
  margin: 10px 0;
}

:global(.rc .r) {
  display: flex;
  justify-content: space-between;
}

:global(.rc .tot) {
  font-weight: 500;
  font-size: 13px;
}

:global(.rc .bc) {
  height: 34px;
  margin: 12px 0 4px;
  background: repeating-linear-gradient(90deg, #1a1814 0 2px, transparent 2px 4px, #1a1814 4px 5px, transparent 5px 8px, #1a1814 8px 11px, transparent 11px 12px);
}

:global(.rc .paper .dl) {
  all: unset;
  cursor: pointer;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  background: #1a1814;
  color: #f4f0e6;
  font: 500 12px "DM Mono", monospace;
  padding: 12px;
  border-radius: 6px;
  box-shadow: none;
  margin-top: 12px;
  text-align: center;
  transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1), background 0.2s, opacity 0.3s;
}

:global(.rc .paper .dl:hover) {
  background: #0E2AF3;
  color: #ffffff;
  transform: translateY(-2px);
}

:global(.rc .paper .dl:active) {
  transform: scale(0.97);
}

:global(.rc .paper .dl.torn) {
  transform: translateY(22px) rotate(4deg);
  opacity: 0;
  pointer-events: none;
}

:global(.rc .act) {
  display: flex;
  gap: 10px;
  justify-content: center;
  margin-top: 14px;
}

:global(.again) {
  all: unset;
  cursor: pointer;
  padding: 12px 22px;
  border-radius: 99px;
  color: #d9d3c6;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  font-size: 13px;
  font-family: "DM Mono", monospace;
  transition: background 0.2s, color 0.2s;
}

:global(.again:hover) {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
}

:global(.again:focus-visible), :global(.dl:focus-visible) {
  outline: 3px solid #F3EFE9;
  outline-offset: 3px;
}

/* Bottom Legal Bar (from Screenshot 4) */
.peepers-legal {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 5.5% 26px;
  background-color: #2349e5;
  background-image: linear-gradient(#ffffff08 1px, transparent 1px), linear-gradient(90deg, #ffffff08 1px, transparent 1px);
  background-size: 54px 54px;
  color: #b9c9ff;
  font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 11px;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
}

.peepers-legal a {
  color: inherit;
  text-decoration: none;
  transition: color 0.2s;
}

.peepers-legal a:hover {
  color: #ffffff;
}

@media (max-width: 600px) {
  .peepers-legal {
    flex-direction: column;
    gap: 10px;
    text-align: center;
    padding: 18px 20px 22px;
  }
}

@media (prefers-reduced-motion: reduce) {
  :global(.in) { animation: none !important; }
  #btn { transition: none; }
  :global(#ov *) { animation: none !important; transition: none !important; }
}
</style>

<script>
(() => {
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const stage = $('#stage');
  if (!stage) return;

  const btn = $('#btn') as HTMLButtonElement;
  const glc = $('#gl') as HTMLCanvasElement;
  const hc = $('#hand') as HTMLCanvasElement;
  if (!glc || !hc) return;

  const hx = hc.getContext('2d');
  const cnt = $('#cnt');
  const ov = $('#ov');
  const sayEl = document.getElementById('say');

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MS = 7;
  const NP = 12;
  const MSPK = 8;
  const MDROP = 6;

  const GLOVE = "M9 14V3.6a2.5 2.5 0 0 1 5 0V12.2a2.2 2.2 0 0 1 4.4 0.4a2.2 2.2 0 0 1 4.4 0.8a2.2 2.2 0 0 1 4.2 1.6V22c0 4-2.6 7-6 7H14.6c-3 0-5.4-1.8-6.6-4.4L4.1 18.6a2.3 2.3 0 0 1 3.6-2.8L9 17.4Z";
  const GL_L = "M18.4 12.6V17.2M22.8 13.4V17.6M14 12.2V16.6";
  const CUFF = "M12.6 28.6h12.2a1.6 1.6 0 0 1 1.6 1.6v3.4a1.6 1.6 0 0 1-1.6 1.6H12.6a1.6 1.6 0 0 1-1.6-1.6v-3.4a1.6 1.6 0 0 1 1.6-1.6Z";
  const CUFF_L = "M15.4 29.2v5.4M18.7 29.2v5.4M22 29.2v5.4";
  const HX = 11.5;
  const HY = 1;

  const GRIPS = [
    [11.5, 3.6], [16.2, 13.2], [20.6, 14], [24.9, 15.8],
    [5.6, 18], [11.5, 10], [18.5, 22], [18.7, 31.6]
  ];

  const VERT = "attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}";
  const FRAG = `precision highp float;
uniform vec2 uRes;uniform float uDpr;uniform vec4 uPill;uniform vec4 uPts[${MS * NP}];uniform float uCount;
uniform vec4 uSpk[${MSPK}];uniform vec4 uSpkR[${MSPK}];uniform vec4 uDrop[${MDROP}];uniform vec4 uMound;uniform vec2 uMoundR;uniform float uLean;uniform float uDark;uniform float uInv;uniform float uHalo;
vec2 smin(vec2 a,vec2 b,float k){float h=clamp(0.5+0.5*(b.x-a.x)/k,0.0,1.0);return vec2(mix(b.x,a.x,h)-k*h*(1.0-h),mix(b.y,a.y,h));}
float cone(vec2 p,vec2 a,vec2 b,float ra,float rb,out float r){vec2 pb=b-a;p-=a;float h=dot(pb,pb);float t=clamp(dot(p,pb)/(h+1e-4),0.0,1.0);r=mix(ra,rb,t);float bb=ra-rb;
if(h<=bb*bb+1e-3){return ra>rb?length(p)-ra:length(p-pb)-rb;}
vec2 q=vec2(dot(p,vec2(pb.y,-pb.x)),dot(p,pb))/h;q.x=abs(q.x);vec2 c=vec2(sqrt(h-bb*bb),bb);float k=c.x*q.y-c.y*q.x;float m=dot(c,q);float n=dot(q,q);
if(k<0.0)return sqrt(h*n)-ra;if(k>c.x)return sqrt(h*(n+1.0-2.0*q.y))-rb;return m-ra;}
vec2 field(vec2 p){float rr=uPill.w*0.5;vec2 c=vec2(uPill.x+uPill.z*0.5,uPill.y+rr);float a=max(0.0,uPill.z*0.5-rr);vec2 q=p-c;
vec2 body=vec2(length(q-vec2(clamp(q.x,-a,a),0.0))-rr,rr);float r;
if(uMoundR.x>0.01){float dm=cone(p,uMound.xy,uMound.zw,uMoundR.x,uMoundR.y,r);body=smin(body,vec2(dm,rr),14.0);}
vec2 st=vec2(1e5,2.0);
for(int s=0;s<${MS};s++){if(float(s)>=uCount)break;vec2 one=vec2(1e5,2.0);
for(int i=0;i<${NP - 1};i++){vec4 A=uPts[s*${NP}+i];vec4 B=uPts[s*${NP}+i+1];float d=cone(p,A.xy,B.xy,A.z,B.z,r);if(d<one.x)one=vec2(d,r+0.3);}
st=smin(st,one,3.5);}
for(int k=0;k<${MSPK};k++){if(uSpkR[k].y<0.5)continue;float d=cone(p,uSpk[k].xy,uSpk[k].zw,uSpkR[k].x,0.35,r);st=smin(st,vec2(d,r+1.0),3.0);}
for(int k=0;k<${MDROP};k++){if(uDrop[k].w<0.5)continue;st=smin(st,vec2(length(p-uDrop[k].xy)-uDrop[k].z,uDrop[k].z),5.0);}
vec2 res=smin(body,st,11.0);res.y=max(res.y,body.y*clamp(-body.x/6.0,0.0,1.0));return res;}
float dist(vec2 p){return field(p).x;}
float env(vec3 R){R.x+=uLean*0.18;float up=-R.y;float e=0.015;
e+=smoothstep(0.3,0.5,up)*smoothstep(0.75,0.55,up)*smoothstep(0.8,0.5,abs(R.x))*2.6;e+=smoothstep(0.8,0.95,up)*0.6;
