---
import Icon from "./Icon.astro";
---
<div class="resource-stories">
  <div class="rs-card">
    <div class="rs-tree" aria-hidden="true"><span class="rs-root">tabs <i>✳</i></span><div class="rs-branches"><span><Icon name="Code2" size={15}/></span><span><Icon name="Bot" size={15}/></span><span><Icon name="Terminal" size={15}/></span></div><div class="rs-bars"><i></i><i></i><i></i></div></div>
    <div class="rs-copy"><small>FOLLOW THE WORK</small><strong>Every process.<br/>In view.</strong><p>See where your resources go.</p></div>
  </div>
  <div class="rs-card rs-diagnose">
    <div class="rs-report" aria-hidden="true"><div class="rs-sheet"><span>DIAGNOSTICS</span><i></i><i></i><i></i><div><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div></div><span class="rs-spark">✳</span><span class="rs-report-tag">A clearer picture ↗</span></div>
    <div class="rs-copy"><small>FIND A WAY FORWARD</small><strong>A slowdown?<br/>Start here.</strong><p>AI Diagnose. Shareable reports.</p></div>
  </div>
</div>
<style>
.resource-stories { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.rs-card { border:1px solid #dfe5f2; border-radius:18px; overflow:hidden; background:#fbfcff; }
.rs-tree, .rs-report { position:relative; height:135px; display:flex; flex-direction:column; align-items:center; justify-content:center; background:linear-gradient(180deg,#f1f4ff,#fbfcff); }
.rs-root { position:relative; display:flex; align-items:center; gap:17px; background:#fff; border:1px solid #dce4f5; border-radius:8px; padding:7px 14px; font:500 12px "DM Sans",sans-serif; letter-spacing:-.05em; color:#52627f; box-shadow:0 5px 10px #25376307; }
.rs-root i { font-style:normal; color:#3259ed; font-size:17px; }
.rs-root::after { position:absolute; content:""; top:100%; left:50%; height:16px; width:1px; background:#c8d4f4; }
.rs-branches { position:relative; width:150px; display:flex; justify-content:space-between; margin-top:25px; }
.rs-branches::before { position:absolute; content:""; left:17px; right:17px; top:-10px; border-top:1px solid #c8d4f4; }
.rs-branches > span { position:relative; display:grid; place-items:center; width:33px; height:30px; background:#fff; border:1px solid #e0e6f4; border-radius:7px; color:#7e93c6; }
.rs-branches > span::before { content:""; position:absolute; bottom:100%; left:50%; height:10px; width:1px; background:#c8d4f4; }
.rs-bars { display:flex; gap:23px; margin-top:8px; }.rs-bars i { width:34px; height:3px; border-radius:99px; background:linear-gradient(90deg,#b2c2ff 65%,#e7edff 65%); }.rs-bars i:nth-child(2) { background:linear-gradient(90deg,#b2c2ff 85%,#e7edff 85%); }
.rs-copy { padding:12px 18px 20px; }.rs-copy small { color:#96a2b7; font:7px monospace; letter-spacing:.1em; }.rs-copy strong { display:block; color:#202b44; font:500 19px/1.15 "DM Sans",sans-serif; letter-spacing:-.04em; margin-top:9px; }.rs-copy p { color:#8290a8; font:9px/1.6 "DM Sans",sans-serif; margin:9px 0 0; }
.rs-sheet { width:88px; height:91px; padding:13px; border:1px solid #dfe5f2; border-radius:9px; background:#fff; transform:rotate(-8deg); box-shadow:8px 8px 0 #e6ecfb; }
.rs-sheet > span { display:block; font:5px monospace; letter-spacing:.1em; color:#9aa7bd; margin-bottom:9px; }.rs-sheet > i { display:block; width:90%; height:3px; background:#e3e9f7; margin:5px 0; border-radius:99px; }.rs-sheet > i:nth-child(3) { width:65%; }.rs-sheet > div { height:21px; display:flex; align-items:end; gap:3px; margin-top:7px; }.rs-sheet > div span { width:4px; height:12px; border-radius:1px; background:#adc0ff; }.rs-sheet > div span:nth-child(3n) { height:19px; }.rs-sheet > div span:nth-child(2n) { height:7px; }
.rs-spark { position:absolute; font-size:41px; color:#3259ed; top:20px; left:calc(50% + 33px); transform:rotate(12deg); }.rs-report-tag { position:absolute; left:calc(50% - 50px); bottom:17px; border-radius:99px; padding:5px 8px; background:#eff3ff; border:1px solid #dce5ff; color:#7891d5; font:6px "DM Sans",sans-serif; transform:rotate(3deg); }
@media(max-width:450px) { .rs-copy { padding-inline:12px; }.rs-copy strong { font-size:17px; }.rs-branches { width:125px; }.rs-bars { gap:11px; } }
</style>
