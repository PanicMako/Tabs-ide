  const lines = document.querySelectorAll<HTMLElement>("[data-scroll-lines] .scroll-line");
  const mockTabs = document.querySelectorAll<HTMLButtonElement>("[data-tabs-mock] .mock-tab");
  const toolBtns = document.querySelectorAll<HTMLButtonElement>("[data-tabs-mock] [data-tool-btn]");
  const toolViews = document.querySelectorAll<HTMLElement>("[data-tabs-mock] [data-tool-view]");

  const projectData: Record<string, { repo: string; branch: string; server: string; url: string }> = {
    throttle: {
      repo: "~/dev/throttle-clan",
      branch: "feature/checkout",
      server: "port: 3000 (Vite)",
      url: "http://localhost:3000/checkout",
    },
    intern: {
      repo: "~/projects/intern-batch-08",
      branch: "main",
      server: "port: 5173 (Astro)",
      url: "http://localhost:5173/preview",
    },
    api: {
      repo: "~/services/payment-api",
      branch: "staging",
      server: "port: 8080 (Go)",
      url: "http://localhost:8080/health",
    },
  };

  const lineToToolMap = ["agents", "code", "server", "git", "browser", "testing"];
  const lineToProjectMap = ["throttle", "throttle", "intern", "intern", "api", "api"];

  let currentActiveIndex = 0;

  const setIndex = (index: number) => {
    if (index < 0 || index >= lines.length) return;
    currentActiveIndex = index;
    lines.forEach((l, i) => l.classList.toggle("highlighted", i === index));
    if (index < lineToToolMap.length) {
      activateTool(lineToToolMap[index]!);
      activateTab(lineToProjectMap[index]!);
    }
  };

  const activateTool = (tool: string) => {
    toolBtns.forEach((btn) => {
      const active = btn.dataset.toolBtn === tool;
      btn.classList.toggle("active", active);
      btn.setAttribute("aria-selected", String(active));
    });
    toolViews.forEach((view) => {
      view.hidden = view.dataset.toolView !== tool;
    });
  };

  const activateTab = (proj: string) => {
    mockTabs.forEach((t) => {
      const active = t.dataset.proj === proj;
      t.classList.toggle("active", active);
      t.setAttribute("aria-selected", String(active));
    });
    const data = projectData[proj];
    if (data) {
      const repoEl = document.querySelector<HTMLElement>("[data-proj-meta='repo']");
      const branchEl = document.querySelector<HTMLElement>("[data-proj-meta='branch']");
      const serverEl = document.querySelector<HTMLElement>("[data-proj-meta='server']");
      const urlEl = document.querySelector<HTMLElement>("[data-browser-url]");
      const serverLinkEl = document.querySelector<HTMLElement>("[data-server-link]");
      const branchDisplayEl = document.querySelector<HTMLElement>("[data-git-branch-display]");
      if (repoEl) repoEl.textContent = data.repo;
      if (branchEl) branchEl.textContent = data.branch;
      if (serverEl) serverEl.textContent = data.server;
      if (urlEl) urlEl.textContent = data.url;
      if (serverLinkEl) serverLinkEl.textContent = data.url;
      if (branchDisplayEl) branchDisplayEl.textContent = data.branch;
    }
  };

  if (lines.length) {
    const updateLines = () => {
      const vh = window.innerHeight;
      const targetY = vh * 0.45;
      let closestDist = Infinity;
      let closestIndex = 0;

      lines.forEach((line, index) => {
        const rect = line.getBoundingClientRect();
        const lineCenter = rect.top + rect.height / 2;
        const dist = Math.abs(lineCenter - targetY);
        if (dist < closestDist) {
          closestDist = dist;
          closestIndex = index;
        }
      });

      if (closestIndex !== currentActiveIndex) {
        setIndex(closestIndex);
      }
    };

    window.addEventListener("scroll", updateLines, { passive: true });
    updateLines();

    // Clicking any line on the left activates its tool and project immediately
    lines.forEach((line, index) => {
      line.addEventListener("click", () => {
        setIndex(index);
        line.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    });
  }

  // Interactive project tabs
  mockTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const proj = tab.dataset.proj;
      if (proj) activateTab(proj);
    });
  });

  // Interactive tool buttons
  toolBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tool = btn.dataset.toolBtn;
      if (tool) {
        activateTool(tool);
        const lineIdx = lineToToolMap.indexOf(tool);
        if (lineIdx !== -1 && lines[lineIdx]) {
          lines.forEach((l, i) => l.classList.toggle("highlighted", i === lineIdx));
          currentActiveIndex = lineIdx;
        }
      }
    });
  });
</script>
