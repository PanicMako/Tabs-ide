---
import { TABS_MARK } from "@tabs/shared/tabsBrand";
interface Props { size?: number; class?: string; }
const { size = 36, class: className = "" } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 390 390" width={size} height={size} fill="currentColor" class={className} aria-hidden="true">
  <path fill-rule="evenodd" d={TABS_MARK.main} />
  <path d={TABS_MARK.detached} />
</svg>
