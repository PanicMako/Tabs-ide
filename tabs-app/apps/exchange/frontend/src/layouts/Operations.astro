---
import Dashboard from "./Dashboard.astro";
import "../styles/review-studio.css";
import "../styles/review-code-studio.css";
import "../styles/review-service-panels.css";
import "../styles/review-desk.css";
interface Props { title: string; accent?: string; description: string; section: "review" | "people" | "security" | "releases" | "reports" }
const { title, accent, description, section } = Astro.props;
---
<Dashboard title={title} accent={accent} description={description} section={section} operations>

  <div class="operations-workspace"><slot /></div>
</Dashboard>
