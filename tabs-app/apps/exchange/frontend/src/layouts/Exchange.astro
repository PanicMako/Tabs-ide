---
import "@fontsource-variable/dm-sans";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/exchange.css";
import CustomCursor from "../components/CustomCursor.astro";

import { exchangeSiteConfiguration } from "../lib/siteConfiguration";
import { extensionMarkPath, extensionMarkViewBox } from "../lib/extensionMark";
const site = exchangeSiteConfiguration(process.env);
interface Props { title: string; description?: string; active?: string; dashboard?: boolean }
const { title, description = "An open extension ecosystem for Tabs. Discover, build, and publish workspace tools.", active, dashboard = false } = Astro.props;
const path = Astro.url.pathname;
const workspace = path.startsWith("/account") || path === "/publish" || path === "/publisher";
const pageKind = workspace ? "workspace" : path.startsWith("/admin") ? "operations" : path.startsWith("/docs") ? "docs" : path === "/" ? "home" : active || "general";
const showSignature = true;
const navigation = [
  ["Extensions", "/extensions", "extensions"],
  ["Developers", "/developers", "developers"],
  ["Docs", site.docs, "docs"],
  ["Publish", "/publish", "publish"],
  ["Resources", "/resources", "resources"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <meta name="exchange-site-name" content={site.name} />

  </head>
  <body data-page={pageKind} data-dashboard={dashboard ? "true" : undefined}>
    <CustomCursor />
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={["site-header", dashboard && "dashboard-header"]}>
      <a class="brand" href={dashboard ? "/account" : "/"} aria-label={dashboard ? "Exchange dashboard" : `${site.name} home`}><svg aria-hidden="true" focusable="false" width="26" height="26" viewBox={extensionMarkViewBox} fill="currentColor"><path d={extensionMarkPath} fill-rule="evenodd" /></svg>{site.name === "Tabs Exchange" ? <span>Tabs <span class="muted">Exchange</span></span> : <span>{site.name}</span>}</a>
      {!dashboard && <button class="dashboard-menu-toggle" id="dashboard-menu-toggle" type="button" aria-controls="dashboard-sidebar" aria-expanded="false" hidden><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg><span class="sr-only">Open site navigation</span></button>}
      {!dashboard && <nav id="dashboard-sidebar" class="mobile-site-menu" aria-label="Main navigation"><div class="dashboard-mobile-heading"><strong>Tabs Exchange</strong><button id="dashboard-menu-close" type="button" data-quiet-control aria-label="Close site navigation">×</button></div>{navigation.map(([label, href, key]) => <a href={href} aria-current={active === key ? "page" : undefined}>{label}</a>)}<a href="/account" class="mobile-dashboard-link">Your dashboard ↗</a></nav>}
      {dashboard && <><span class="header-workspace-label">/ Workspace</span><button class="dashboard-menu-toggle" id="dashboard-menu-toggle" type="button" aria-controls="dashboard-sidebar" aria-expanded="false" hidden><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg><span class="sr-only">Open workspace navigation</span></button></>}
      <details class="header-workspace-menu" data-header-workspace><summary role="button" aria-label={dashboard ? "Your account" : "Your workspace"}><span class="account-monogram" id="account-monogram" aria-hidden="true">T</span><span id="account-summary-name">{dashboard ? "Your account" : "Your workspace"}</span><svg class="account-chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 4.5 3 3 3-3" /></svg></summary><nav aria-label={dashboard ? "Your account" : "Your workspace"}><p class="header-menu-label">{dashboard ? "ACCOUNT" : "WORKSPACE"}</p><a class="header-account-link" id="account-link" href="/account" aria-current={path === "/account" ? "page" : undefined}>Publisher workspace ↗</a>{!dashboard && <><a id="reviewer-link" href="/admin" aria-current={active === "review" ? "page" : undefined} hidden>Review desk</a><a id="operator-link" href="/admin/reviewers" aria-current={active === "operator" ? "page" : undefined} hidden>Reviewer access</a></>}{dashboard && <><button id="dashboard-signout" type="button" class="header-signout" hidden>Sign out <span aria-hidden="true">↗</span></button><p id="dashboard-session-status" role="status" aria-live="polite"></p></>}</nav></details>
    </header>
    <main id="main" class:list={[dashboard && "dashboard-main"]} tabindex="-1"><slot /></main>
    <footer class:list={["site-footer", dashboard && "dashboard-footer"]} id="exchange-footer">
      {dashboard ? <div class="dashboard-footer-inner"><a href="/extensions" class="dashboard-exit">Browse Exchange ↗</a><nav aria-label="Footer navigation"><a href={site.docs}>Documentation</a><a href="/developers">Developer tools</a><a href="/resources">Resources</a><a href="/publisher-terms">Publisher terms</a><a href="/docs/extensions/registry-api">Registry API</a>{site.support && <a href={site.support}>Instance support</a>}</nav><a href="https://buildwithtabs.com">Built with Tabs ↗</a></div> : <>
      <div class="footer-top"><span class="footer-spark" aria-hidden="true">✳</span><div><p class="eyebrow">A space for what’s next</p><p class="footer-intro">A good idea deserves<br /><em class="editorial-accent">a little room.</em></p></div><a class="button footer-cta" data-aurora-liquid="white" href="/developers">Make something for Tabs <span aria-hidden="true">↗</span></a></div>
      <div class="footer-links"><a href="https://buildwithtabs.com">Meet Tabs IDE <span aria-hidden="true">↗</span></a><nav aria-label="Footer navigation"><a href="/extensions">Extensions</a><a href="/developers">Developers</a><a href={site.docs}>Documentation</a><a href="/resources">Resources</a>{site.support && <a href={site.support}>Instance support</a>}<a href="/publisher-terms">Publisher terms</a><a href="/docs/extensions/registry-api">Registry API</a></nav></div>
      {showSignature && <><div class="exchange-signature" data-official={site.name === "Tabs Exchange" ? "true" : undefined} aria-label={site.name}>{site.name === "Tabs Exchange" ? <><span aria-hidden="true">Tabs</span><span aria-hidden="true">Exchange</span></> : <span aria-hidden="true">{site.name}</span>}</div><div class="exchange-baseline"><span>Make room for your next tool.</span><span>Built in the open.</span><a class="footer-back-top" href="#main" aria-label="Back to top">↑</a></div></>}
      </>}
    </footer>
  </body>
</html>
<script>
  import "../scripts/account";
  import "../scripts/header-workspace";
  import "../scripts/dashboard-navigation";
  import "../scripts/arrow-icons";
  import "../scripts/wordmark";
  import "../scripts/custom-select";
  import "../scripts/button-liquid";
  import "../scripts/motion";
</script>
