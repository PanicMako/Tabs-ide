---
import Account from "../layouts/Account.astro";
import PublisherJourney from "../components/PublisherJourney.astro";
import { extensionMarkPath, extensionMarkViewBox } from "../lib/extensionMark";
---
<Account title="Publish an" titleAccent="extension" section="publish">
  <PublisherJourney current="package" />
  <p class="publisher-availability">Every version is scanned and manually reviewed before signed publication. Approval alone does not publish a package.</p>
  <div class="publish-layout publish-workspace-layout">
    <form id="publish-form" class="publish-panel">
      <p id="publish-status" role="status" aria-live="polite" class="notice" style="margin:20px 0">Checking publishing prerequisites…</p>
      <fieldset id="publish-fields" disabled>
        <legend class="sr-only">Prepare your submission</legend>

        <section class="publish-step" aria-labelledby="publish-identity-heading">
          <p class="step-label">01 / Publisher identity</p>
          <h2 id="publish-identity-heading">Publisher namespace</h2>
          <p class="muted" style="font-size:14px;margin-bottom:18px">Choose the publisher for this release. Membership does not confer verified ownership.</p>
          <label for="publish-namespace" style="font-weight:600;font-size:13px;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted)">Publisher namespace</label>
          <select id="publish-namespace" required style="margin-top:8px">
            <option value="">Select your namespace</option>
          </select>
          <p style="font-size:13px;margin:12px 0 20px"><a href="/account/namespaces">Create or manage a namespace</a> · Required before publishing.</p>
          <details class="publish-name-planner"><summary id="name-planner-heading">Checking a new package name?</summary><div>

            <p class="muted">People see a title like <strong>Simulators</strong>. The package ID pairs its name with your publisher or studio namespace.</p>
            <div class="name-planner-fields">
              <div><label for="tool-display-name">Display name</label><input id="tool-display-name" maxlength="100" placeholder="Simulators" /></div>
              <div><label for="tool-package-name">Package name</label><input id="tool-package-name" maxlength="63" placeholder="simulators" aria-describedby="tool-name-status" /></div>
            </div>
            <div class="name-planner-actions"><button type="button" id="tool-name-check" class="button secondary">Check package name</button><a id="tool-name-search" href="/extensions">Explore similar tools</a></div>
            <p id="tool-name-status" role="status" aria-live="polite">Select a namespace and enter a package name to check it.</p>
            <div id="tool-name-selection" hidden>
              <p><strong id="tool-name-title"></strong><br /><code id="tool-name-id"></code></p>
              <p>Use these values in <code>tabs-extension.json</code> before building your archive. This check does not reserve a name or rename an uploaded package.</p>
              <pre id="tool-name-manifest"></pre>
              <button id="tool-name-copy" type="button" class="button secondary">Copy manifest fields</button>
            </div>
            <details class="extension-naming-help"><summary>Can two tools share a name?</summary><p>Display names can be shared. Within a namespace, a package name identifies one tool across all its versions. A name already in your namespace is for updating that tool. Your namespace can be a studio or team name; it does not have to match your GitHub username.</p></details>
          </div></details>
          <label class="publisher-agreement" style="display:flex;align-items:flex-start;gap:10px;font-size:14px;cursor:pointer">
            <input id="publish-agreement" type="checkbox" required style="margin-top:3px" />
            <span>I have read and accept this instance's <a href="/publisher-terms" target="_blank" rel="noopener">publisher terms<span class="sr-only"> (opens in a new tab)</span></a>.</span>
          </label>
          <p id="publish-terms" class="muted" style="font-size:12px;margin:8px 0 0 24px">Loading publisher terms version…</p>
        </section>

        <section class="publish-step" aria-labelledby="publish-package-heading">
          <p class="step-label">02 / Built package</p>
          <h2 id="publish-package-heading">Package archive</h2>
          <div id="publish-drop" class="package-drop">
            <div class="package-mark" aria-hidden="true"><svg viewBox={extensionMarkViewBox} fill="currentColor"><path d={extensionMarkPath} fill-rule="evenodd" /></svg><span>.tabsext</span></div>
            <div class="upload-choice">
              <label for="publish-file">Choose a package</label>
              <p>Drop one built package here, or choose it below.</p>
              <input id="publish-file" type="file" accept=".tabsext" aria-describedby="publish-file-help" required />
            </div>
            <p id="publish-file-help" class="muted upload-help">One <code>.tabsext</code> file · Up to 25 MiB. The registry validates the package before review.</p>
            <p id="publish-file-summary" aria-live="polite" style="font-weight:700;color:var(--accent);margin-top:12px"></p>
          </div>
          <button class="button" type="submit" style="width:100%" disabled>Submit for review</button>
        </section>
      </fieldset>

      <progress id="publish-progress" max="100" value="0" aria-label="Package upload progress" hidden></progress>
      <div class="actions" style="margin-top:16px">
        <button id="publish-cancel" class="button secondary" type="button" hidden>Cancel upload</button>
      </div>
      <p style="font-size:14px"><a href="/account/extensions">View existing submissions</a></p>
    </form>

    <aside class="publication-guide" aria-labelledby="publication-guide-title">
      <p class="desk-kicker">FROM PACKAGE TO WORKSPACE</p>
      <h2 id="publication-guide-title">A clear path.<br /><em class="editorial-accent">A careful review.</em></h2>
      <ol class="publication-path"><li><strong>Send your package</strong><p>Upload the built archive from your extension project.</p></li><li><strong>Checks and review</strong><p>Automated scans and a manual review happen before publication.</p></li><li><strong>Signed publication</strong><p>An approved version still needs a signed release before it becomes available.</p></li></ol>
      <div class="publisher-help-note"><strong>Still building?</strong><p>Start with the SDK, then return with your built package. You don’t need a CLI token to submit here.</p><a href="/docs/extensions">Build your first extension ↗</a></div>
      <a href="/docs/extensions/publishing" class="quiet-text-link">Read the publishing guide ↗</a>
    </aside>
  </div>
</Account>
<script>
  import "../scripts/publish";
  import "../scripts/tool-naming";
</script>
