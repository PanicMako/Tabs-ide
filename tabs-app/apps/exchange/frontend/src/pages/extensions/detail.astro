---
import { publisherSealViewBox, publisherSealPath, publisherSealCheck, publisherVerificationLabel, publisherVerificationExplanation } from "@tabs/shared/publisherVerification";
import Exchange from "../../layouts/Exchange.astro";
import { extensionMarkPath, extensionMarkViewBox } from "../../lib/extensionMark";
---
<Exchange title="Extension overview" description="Review a Tabs-native extension before installation." active="extensions">
  <div class="detail-back">
    <a href="/extensions" class="detail-back-link">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M11 2L5 8l6 6"/></svg>
      Back to all extensions
    </a>
  </div>

  <p id="extension-status" role="status" aria-live="polite" class="registry-status">Loading the published overview…</p>

  <div id="extension-error" hidden class="notice" style="background:#fef2f2;border-color:#fecaca;margin-bottom:28px">
    <p id="extension-error-message" style="color:#991b1b;font-weight:600"></p>
    <div class="actions" style="margin-top:12px">
      <button id="extension-retry" class="button secondary" type="button">Retry overview</button>
      <a id="extension-signin" class="button" href="/auth/github/start">Sign in to reconnect</a>
    </div>
  </div>

  <article id="extension-overview" hidden>
    <header class="detail-hero">
      <div class="detail-icon-wrap">
        <svg aria-hidden="true" width="40" height="40" viewBox={extensionMarkViewBox} fill="currentColor"><path d={extensionMarkPath} fill-rule="evenodd" /></svg>
        <img id="extension-icon" width="80" height="80" alt="" hidden />
      </div>
      <div class="detail-hero-content">
        <p id="extension-identity" class="eyebrow"></p><span id="extension-verified" class="publisher-verified-badge" role="img" aria-label={publisherVerificationLabel} title={publisherVerificationExplanation} hidden><svg viewBox={publisherSealViewBox} width="18" height="18" aria-hidden="true" focusable="false"><path d={publisherSealPath} fill="currentColor" /><path d={publisherSealCheck} fill="none" stroke="white" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
        <h1 id="extension-title"></h1>
        <p id="extension-description" class="lead"></p>
      </div>
    </header>

    <div class="detail-version-card">
      <div>
        <label for="extension-version">Selected release version</label>
        <select id="extension-version">
          <option value="">Latest published stable release</option>
          <optgroup id="extension-stable" label="Stable releases"></optgroup>
          <optgroup id="extension-prerelease" label="Prereleases"></optgroup>
        </select>
      </div>
      <span class="muted" style="font-size:13px">Tabs resolves compatible releases against your desktop client version.</span>
    </div>

    <div class="detail-grid">
      <div class="detail-main-column">
        <section id="extension-previews" hidden class="card">
          <h2>Packaged previews</h2>
          <div id="extension-preview-images" class="extension-previews"></div>
        </section>

        <section class="card">
          <h2>Overview</h2>
          <p id="extension-readme-status" role="status" aria-live="polite"></p>
          <div id="extension-readme" class="prose"></div>
          <button id="extension-readme-retry" class="button secondary" type="button" hidden style="margin-top:16px">Retry README</button>
        </section>

        <section class="card">
          <h2>Release notes</h2>
          <p id="extension-release-notes" class="prose" style="font-size:15px;color:var(--muted);line-height:1.6"></p>
        </section>

        <details id="extension-history">
          <summary>Published release history</summary>
          <div style="padding: 24px 28px">
            <p id="extension-history-status" role="status" aria-live="polite" class="muted">Open to load releases independently of the overview.</p>
            <ul id="extension-history-list" style="margin: 16px 0; padding-left: 20px"></ul>
            <button id="extension-history-more" class="button secondary" type="button">Load releases</button>
          </div>
        </details>
      </div>

      <div class="detail-side-column">
        <section class="install-card">
          <h2>Install in Tabs</h2>
          <p style="font-size:14px;color:var(--muted);line-height:1.6">Open Tabs → Settings → Extensions → Discover. Search for this extension in the official Exchange. Custom registries require their own trusted configuration.</p>
          <div id="extension-install-identity"></div>
          <p class="muted" style="font-size:12px;margin:12px 0 20px">Project enablement and profiles are isolated. Browser downloads are for local inspection only.</p>
          <a id="extension-download" class="button" style="width:100%">Download package for inspection</a>
        </section>

        <section class="meta-card">
          <h2>Help & concerns</h2>
          <p>For help using this extension, use the publisher’s Support link below.</p>
          <details><summary>Report a concern to Tabs</summary>
            <p>Your report is private to the review team. Do not include passwords, tokens, or personal files. Reports do not automatically remove an extension.</p>
            <form id="extension-report" class="extension-report-form"><fieldset>
              <legend>Report this version</legend>
              <label for="report-category">What is the concern?</label>
              <select id="report-category" name="category"><option value="security">Malware or suspicious behaviour</option><option value="privacy">Privacy or unexpected data access</option><option value="impersonation">Impersonation</option><option value="policy">Misleading or prohibited content</option><option value="other">Another concern</option></select>
              <label for="report-details">What happened?</label>
              <textarea id="report-details" name="details" required minlength="10" maxlength="4000" rows="5" placeholder="Describe what you observed and how to reproduce it."></textarea>
              <button type="submit" class="button secondary">Send private report</button>
            </fieldset><p role="status" data-result></p><a data-signin hidden>Sign in to report</a></form>
          </details>
        </section>

        <section class="meta-card">
          <h2>Compatibility & Access</h2>
          <dl id="extension-metadata"></dl>
          <h3 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin:24px 0 10px">Requested capabilities</h3>
          <ul id="extension-permissions"></ul>
          <h3 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin:20px 0 8px">External services</h3>
          <p id="extension-services" style="font-size:14px;color:var(--muted);line-height:1.6;margin:0 0 20px"></p>
          <h3 style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin:20px 0 8px">Publisher resources</h3>
          <nav id="extension-links" aria-label="Publisher resources"></nav>
        </section>
      </div>
    </div>

    <p class="notice" style="margin-top:48px">Every published version has been manually reviewed and entered signed metadata. Review is not a security guarantee.</p>
  </article>
</Exchange>
<script>import "../../scripts/extension"; import "../../scripts/extension-report";</script>
