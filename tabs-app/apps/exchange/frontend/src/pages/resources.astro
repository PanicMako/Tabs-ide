---
import Exchange from "../layouts/Exchange.astro";
import { exchangeSiteConfiguration } from "../lib/siteConfiguration";
const site = exchangeSiteConfiguration(process.env);
const guides = [
  { number: "01", kind: "Start making", title: "Your first extension", description: "The toolkit, a working template, and your first view inside Tabs.", href: "/developers", tint: "peach", spine: "THE WORKSHOP" },
  { number: "02", kind: "Keep it close", title: "The reference library", description: "SDK methods, the manifest contract, permissions, and host API limits.", href: site.docs, tint: "blue", spine: "THE FIELD GUIDE" },
  { number: "03", kind: "Make it your own", title: "Your own Exchange", description: "Private access, package storage, signing, and compatible clients.", href: "/docs/extensions/self-hosting", tint: "green", spine: "THE OPERATOR’S MANUAL" },
];
---
<Exchange title="Resources" description="Useful guides for extension makers, publishers, and registry operators." active="resources">
  <section class="ex-hero library-heading" aria-labelledby="resources-title"><p class="eyebrow">A shelf for the curious</p><h1 id="resources-title">Good things<br /><em class="editorial-accent">to build on.</em></h1><p class="lead">Pick a guide. Make something useful. Come back when you need the next piece.</p></section>
  <nav class="reference-shelf" aria-label="Resource collections">{guides.map((guide) => <a class={`reference-book book-${guide.tint}`} href={guide.href}><span class="book-spine" aria-hidden="true">{guide.spine}</span><div class="book-cover"><span class="book-topline">TABS EXCHANGE <span>{guide.number}</span></span><span class="book-kind">{guide.kind}</span><h2>{guide.title}</h2><span class="book-drawing" aria-hidden="true">{guide.number === "01" ? <><i class="draw-file">&lt;/&gt;</i><i class="draw-workspace">+ Your tool</i></> : guide.number === "02" ? <><i class="draw-lines"></i><i class="draw-bracket">{"{ }"}</i></> : <><i class="draw-registry">Exchange</i><i class="draw-orbits">↗ &nbsp; ↘</i><i class="draw-clients">Your team</i></>}</span><p>{guide.description}</p><span class="book-open">Open the guide <span aria-hidden="true">↗</span></span></div></a>)}</nav>
  <section class="library-index" aria-labelledby="library-index-title"><div><p class="eyebrow">Find the specific thing</p><h2 id="library-index-title">Straight to<br /><em class="editorial-accent">the useful part.</em></h2></div><nav aria-label="Specific resource guides"><a href="/docs/extensions/development"><span>Development & debugging</span><small>Load, watch, reload</small><span aria-hidden="true">↗</span></a><a href="/docs/extensions/permissions"><span>Permissions & profiles</span><small>Access and isolation</small><span aria-hidden="true">↗</span></a><a href="/docs/extensions/registry-api"><span>Registry API</span><small>Requests and responses</small><span aria-hidden="true">↗</span></a><a href="/docs/extensions/publishing"><span>Publishing & review</span><small>From archive to signed release</small><span aria-hidden="true">↗</span></a><a href="/account"><span>Publisher workspace</span><small>Namespaces and submissions</small><span aria-hidden="true">↗</span></a><a href="/docs/extensions/troubleshooting"><span>Troubleshooting</span><small>When something gets stuck</small><span aria-hidden="true">↗</span></a></nav></section>
  <section class="community-desk" aria-labelledby="community-title"><div><p class="eyebrow">Build in the open</p><h2 id="community-title">Help the next<br /><em class="editorial-accent">person along.</em></h2></div><div><h3>Report a reproducible bug</h3><p>Use the source repository’s issue tracker. Include your desktop and SDK versions, operating system, and the smallest set of steps that reproduces the problem. Leave out credentials and private paths.</p><section aria-labelledby="security-title"><h3 id="security-title">Keep security reports private</h3><p>Use the published security policy or the operator’s private reporting channel for vulnerabilities, exploit details, or exposed credentials. Ordinary support is not automatically a confidential vulnerability inbox.</p></section>{site.support ? <a class="text-link" href={site.support}>Contact instance support <span aria-hidden="true">↗</span></a> : <p class="support-unconfigured">A support channel has not been configured for this instance.</p>}</div></section>
</Exchange>
