---
import Account from "../../layouts/Account.astro";
import PublisherJourney from "../../components/PublisherJourney.astro";
---
<Account title="Your publisher" titleAccent="identity" section="namespaces">
  <PublisherJourney current="identity" />
  <p id="publishing-availability" role="status" class="publisher-availability">Checking publisher account setup…</p>
  <div class="identity-layout">
    <section class="identity-form-card" aria-labelledby="new-namespace-heading">
      <div class="publisher-card-heading"><span class="desk-kicker">START HERE</span><span class="quiet-badge">About a minute</span></div>
      <h2 id="new-namespace-heading">What name will you publish under?</h2>
      <p class="card-introduction">A personal name, a studio, or your team. This is your <strong>namespace</strong>—the first part of every extension’s ID.</p>
      <section id="namespace-ready" class="namespace-ready" tabindex="-1" hidden aria-labelledby="namespace-ready-title"><p id="namespace-ready-message"></p><div class="namespace-next-step"><span class="quiet-badge">Next step · Build</span><h3 id="namespace-ready-title">Bring your extension to life.</h3><p>Use your namespace in your extension project, then build a <code>.tabsext</code> package. Already have a package? Check its publisher name matches.</p><div class="namespace-next-actions"><a class="button" href="/developers">Build your extension ↗</a><a class="quiet-text-link" href="/publish">I already have a package ↗</a></div></div><p id="namespace-ready-availability" class="field-help"></p><button id="namespace-create-another" class="button secondary" type="button">Create another namespace</button></section>
      <form id="create-namespace" class="task-form" novalidate>
        <div class="form-field"><label for="new-namespace">Publisher namespace</label><input id="new-namespace" disabled name="name" required pattern="[a-z](?:[a-z0-9]|-){1,62}" autocapitalize="none" minlength="2" maxlength="63" autocomplete="off" spellcheck="false" placeholder="e.g. rushil" aria-describedby="namespace-name-help namespace-feedback" /><p id="namespace-name-help" class="field-help">2–63 letters, numbers or hyphens. Start with a letter. Capitals are saved as lowercase.</p></div>
        <div class="identity-preview" aria-label="Example extension identity"><span class="identity-preview-mark" aria-hidden="true">↗</span><div><small>YOUR EXTENSIONS WILL LOOK LIKE THIS</small><code><output id="namespace-example-name" for="new-namespace">your-name</output><span>.your-tool</span></code></div></div>
        <label class="check publisher-agreement"><input type="checkbox" id="accept-terms" disabled required /> <span>I have read and accept the <a href="/publisher-terms" target="_blank" rel="noopener">publisher terms <span class="sr-only">(opens in a new tab)</span></a>.</span></label>
        <p id="namespace-feedback" class="namespace-feedback" role="status" aria-live="polite" aria-atomic="true"></p>
        <div class="identity-form-actions"><button class="button" type="submit" disabled>Create namespace <span aria-hidden="true">↗</span></button><p>Your GitHub account stays the same.</p></div>
      </form>
    </section>
    <aside class="identity-guide" aria-label="Publisher identity help">
      <section class="identity-notes"><span class="desk-kicker">A NAME TO BUILD ON</span><h2>Yours, across<br /><em class="editorial-accent">every tool.</em></h2><p>One namespace can hold many extensions. It can be different from your GitHub username.</p><dl><div><dt>Namespace</dt><dd>The person or team publishing.</dd></div><div><dt>Extension name</dt><dd>The individual tool, such as <code>relay</code>.</dd></div></dl><a class="quiet-text-link" href="/docs/extensions/publishing">How publishing works ↗</a></section>
      <section class="namespace-memberships publisher-owned-names" aria-labelledby="membership-heading"><div class="publisher-card-heading"><h2 id="membership-heading">Your namespaces</h2><span class="quiet-badge">Account</span></div><ul id="account-namespaces"></ul><details class="task-help"><summary>About publisher verification</summary><p>A namespace gives you a publishing identity. It does not confer verified status. <a href="/publisher#namespace-title">Advanced namespace controls</a></p></details></section>
    </aside>
  </div>
  <section class="publisher-team" aria-labelledby="publisher-team-heading"><div class="publisher-section-heading"><div><span class="desk-kicker">WHEN YOU NEED A HAND</span><h2 id="publisher-team-heading">Make room for your team.</h2></div><span class="quiet-badge">Optional</span></div><div class="namespace-team-grid"><div id="namespace-collaborators"></div><div id="namespace-invitations"></div></div><div id="namespace-members"></div></section>
</Account>
<script>import "../../scripts/collaborators"; import "../../scripts/invitations"; import "../../scripts/members"; import "../../scripts/publisher-setup";</script>
