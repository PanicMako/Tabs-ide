---
import Exchange from "../layouts/Exchange.astro";
import DeveloperIllustration from "../components/DeveloperIllustration.astro";
import PublicationIllustration from "../components/PublicationIllustration.astro";
import { extensionApiVersion } from "../../../../marketing/src/lib/extension-docs";
---
<Exchange title="Build a Tabs extension" description="Create, test, and package your own full-workspace tool for Tabs." active="developers">
  <div class="developer-hero">
    <section class="ex-hero" aria-labelledby="developers-title">
      <p class="eyebrow">The developer workshop · API {extensionApiVersion}</p>
      <h1 id="developers-title">A few files.<br />A whole new<br /><em class="editorial-accent">way to work.</em></h1>
      <p class="lead">Make a project planner, a focused scratchpad, or something only your team needs. Your extension gets its own view, right inside Tabs.</p>
      <div class="actions"><a class="button" href="#developer-toolkit">Get the toolkit <span aria-hidden="true">↗</span></a><a class="text-link" href="/docs/extensions">Read the quick start <span aria-hidden="true">↗</span></a></div>
      <p class="workshop-version">React or plain HTML · Experimental SDK & CLI</p>
    </section>
    <DeveloperIllustration />
  </div>

  <section class="toolkit-desk" id="developer-toolkit" aria-labelledby="dev-bundle-title">
    <div class="toolkit-desk-copy"><p class="eyebrow">01 / Everything to get started</p><h2 id="dev-bundle-title">Your first<br /><em class="editorial-accent">set of tools.</em></h2><p>The SDK, standalone CLI, and setup instructions in one versioned download. Start in a fresh folder—no Tabs source checkout required.</p><p id="release-status-message" role="status" class="toolkit-availability">Checking this instance’s developer bundle…</p><div class="actions"><a class="button" id="release-download" hidden download>Download SDK + CLI</a><a class="text-link" id="release-checksums" hidden>SHA256 checksums <span aria-hidden="true">↗</span></a></div><button class="button secondary" id="release-retry" type="button" hidden>Try loading the bundle again</button><details class="toolkit-integrity" id="release-integrity" hidden><summary>Verify your download</summary><p id="release-digest"></p><p>Checksums detect corruption. They are not independent proof of authenticity.</p></details></div>
    <div class="toolkit-inventory"><span class="toolkit-inventory-label">INSIDE THE BUNDLE</span><dl><div><dt><span>01</span>Typed SDK</dt><dd>API declarations for tools, profiles, and scoped host resources.</dd></div><div><dt><span>02</span>Standalone CLI</dt><dd>Scaffold, validate, build, inspect, and package your extension.</dd></div><div><dt><span>03</span>Two starting points</dt><dd>A React/TypeScript starter or a plain HTML workspace.</dd></div></dl><p>Requires Node, npm, and a compatible Tabs development/testing build. Nothing here implies an npm or public desktop release.</p></div>
  </section>

  <section class="workshop-route" aria-labelledby="workshop-route-title"><div class="section-heading"><div><p class="eyebrow">02 / At your workbench</p><h2 id="workshop-route-title">Make it work.<br /><em class="editorial-accent">Make it yours.</em></h2></div><p>Pick up where you are. Each guide takes you to the next useful step.</p></div><nav aria-label="Extension development guides"><a href="/docs/extensions"><span class="route-number">01</span><div><h3>Start with a working template</h3><p>Extract the bundle, scaffold your project, and build your first package.</p></div><span class="route-art route-files" aria-hidden="true"><i>src/</i><i>manifest</i><i>dist/</i></span><span class="route-arrow" aria-hidden="true">↗</span></a><a href="/docs/extensions/development"><span class="route-number">02</span><div><h3>See it inside your project</h3><p>Load the development folder, watch builds, reload, and debug in context.</p></div><span class="route-art route-workspace" aria-hidden="true"><i>Tabs / project</i><b>+ Your tool</b></span><span class="route-arrow" aria-hidden="true">↗</span></a><a href="/docs/extensions/reference"><span class="route-number">03</span><div><h3>Connect to scoped host resources</h3><p>Read the manifest contract, SDK methods, permission requirements, and limits.</p></div><span class="route-art route-code" aria-hidden="true">{ "{ }" }<small>Host API</small></span><span class="route-arrow" aria-hidden="true">↗</span></a></nav></section>

  <section class="workshop-publication" aria-labelledby="share-tool-title"><div><p class="eyebrow">03 / Into another workspace</p><h2 id="share-tool-title">Built by you.<br /><em class="editorial-accent">Useful to someone.</em></h2><p>Validate and pack your archive, then submit through your publisher account. Follow findings, corrections, and release status in one place.</p><div class="actions"><a class="text-link" href="/docs/extensions/publishing">Read the publishing guide <span aria-hidden="true">↗</span></a><a class="text-link" href="/publish">Prepare a submission <span aria-hidden="true">↗</span></a></div></div><PublicationIllustration /></section>
</Exchange>
<script>import "../scripts/developer-release";</script>
