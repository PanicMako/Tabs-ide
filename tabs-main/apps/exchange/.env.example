POSTGRES_PASSWORD=replace-with-a-long-random-password
S3_ACCESS_KEY_ID=replace-with-an-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
EXCHANGE_ORIGIN=http://localhost:8787
# Public presentation settings are embedded at build time; rebuild after changes.
EXCHANGE_WEB_SITE_NAME=Tabs Exchange
EXCHANGE_WEB_DOCS_URL=/docs/extensions
EXCHANGE_WEB_SUPPORT_URL=
# Compose exposes only loopback; terminate production HTTPS at your reverse proxy.
EXCHANGE_HTTP_PORT=8787
EXCHANGE_S3_PORT=8333
EXCHANGE_PUBLISHING_ENABLED=false
EXCHANGE_VISIBILITY=public
# Private instances require comma-separated numeric GitHub account IDs.
EXCHANGE_ALLOWED_GITHUB_IDS=
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
EXCHANGE_ADMIN_GITHUB_IDS=replace-with-numeric-github-user-id
# Explicit operator bootstrap; existing admins are reviewers, not role delegates.
EXCHANGE_OPERATOR_GITHUB_IDS=
