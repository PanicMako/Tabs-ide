{
  "name": "@tabs/desktop",
  "version": "1.3.17",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun run scripts/dev-desktop.mjs",
    "dev:bundle": "tsdown --watch",
    "dev:backend-bundle": "bun --cwd=../server run dev:bundle",
    "dev:electron": "bun run scripts/dev-electron.mjs",
    "build": "tsdown",
    "start": "bun run scripts/start-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs",
    "test:browser-workflows": "node scripts/browser-workflows-smoke.mjs"
  },
  "dependencies": {
    "@clerk/electron": "0.0.37",
    "@clerk/electron-passkeys": "0.0.3",
    "@effect/platform-node": "catalog:",
    "@tabs/client-runtime": "workspace:*",
    "@tabs/extension-package": "workspace:*",
    "@tabs/ssh": "workspace:*",
    "effect": "catalog:",
    "electron": "44.1.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2",
    "tldts": "^7.0.26"
  },
  "devDependencies": {
    "@tabs/contracts": "workspace:*",
    "@tabs/shared": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wait-on": "^8.0.2"
  },
  "productName": "Tabs"
}
