---
import Layout from "../layouts/Layout.astro";
import { configuredExchangeOrigin } from "../lib/exchange-url";

const exchange = configuredExchangeOrigin(import.meta.env.PUBLIC_TABS_EXCHANGE_URL);
---

<Layout title="Explore Tabs Extensions" description="Discover reviewed, Tabs-native full-workspace tools.">
  <section class="exchange-page">
    <p class="eyebrow">TABS EXCHANGE</p>
    <h1>Explore Extensions</h1>
    <p>Tabs extensions are full-workspace tools built for Tabs, not VS Code .vsix packages. Every public version is reviewed before listing; approval is not a security guarantee.</p>
    {exchange ? (
      <div id="catalog" data-exchange-url={exchange}>
        <label for="search">Search extensions</label>
        <input id="search" type="search" placeholder="Search by name or publisher" />
        <p id="catalog-status" role="status" aria-live="polite">Loading approved extensions...</p>
        <ul id="catalog-list"></ul>
        <button id="catalog-more" type="button" hidden>Load more extensions</button>
      </div>
    ) : (
      <p role="status">Tabs Exchange discovery is not available yet. The desktop development format is experimental.</p>
    )}
    <p><a href="/publish-extension">Want to publish a tool? See how submission works.</a></p>
  </section>
</Layout>

<script>
  import { extensionDetailHref } from "../lib/extension-listing";

  const catalog = document.getElementById("catalog");
  if (catalog) {
    const origin = catalog.dataset.exchangeUrl;
    const input = document.getElementById("search") as HTMLInputElement;
    const status = document.getElementById("catalog-status")!;
    const list = document.getElementById("catalog-list")!;
    const moreButton = document.getElementById("catalog-more") as HTMLButtonElement;
    let sequence = 0;
    let nextCursor: string | null = null;
    const seenCursors = new Set<string>();
    const load = async (append = false) => {
      if (append && !nextCursor) return;
      const current = ++sequence;
      if (!append) {
        list.replaceChildren();
        nextCursor = null;
        seenCursors.clear();
      }
      const url = new URL("/v1/extensions", origin);
      url.searchParams.set("q", input.value.trim());
      url.searchParams.set("limit", "30");
      if (append && nextCursor) url.searchParams.set("cursor", nextCursor);
      moreButton.hidden = !append;
      moreButton.disabled = true;
      status.textContent = "Loading approved extensions...";
      try {
        const response = await fetch(url.href, { redirect: "error" });
        if (!response.ok) throw new Error("The catalog could not be loaded.");
        const data = await response.json();
        if (current !== sequence) return;
        if (!Array.isArray(data.extensions) || data.extensions.length > 30) throw new Error("Invalid catalog page.");
        const cursor = data.nextCursor;
        if (cursor !== null && cursor !== undefined &&
          (typeof cursor !== "string" || cursor.length > 256 || !/^[A-Za-z0-9_-]+$/.test(cursor) || seenCursors.has(cursor) || !data.extensions.length)) {
          throw new Error("Invalid catalog cursor.");
        }
        const firstNewIndex = list.children.length;
        for (const extension of data.extensions) {
          const detailHref = extensionDetailHref(extension.namespace, extension.name);
          if (!detailHref) continue;
          const item = document.createElement("li");
          const title = document.createElement("a");
          title.textContent = extension.manifest.displayName;
          title.href = detailHref;
          const description = document.createElement("p");
          description.textContent = `${extension.manifest.description} — ${extension.namespace}.${extension.name}, version ${extension.version}${extension.verified ? ", verified publisher" : ", unverified publisher"}`;
          item.append(title, description);
          list.append(item);
        }
        nextCursor = typeof cursor === "string" ? cursor : null;
        if (nextCursor) seenCursors.add(nextCursor);
        if (append) list.children[firstNewIndex]?.querySelector("a")?.focus();
        moreButton.hidden = !nextCursor;
        moreButton.disabled = !nextCursor;
        status.textContent = list.children.length
          ? `${list.children.length} approved extensions shown${nextCursor ? ", more available" : ""}.`
          : "No approved extensions found.";
      } catch {
        if (current === sequence) {
          status.textContent = "The catalog is unavailable. Please try again later.";
          moreButton.hidden = !nextCursor;
          moreButton.disabled = !nextCursor;
        }
      }
    };
    input.addEventListener("input", () => { void load(); });
    moreButton.addEventListener("click", () => { void load(true); });
    void load();
  }
</script>

<style>
  .exchange-page { max-width: 48rem; margin: 2rem auto 5rem; padding: 0 1.5rem; line-height: 1.6; }
  .eyebrow { color: #a1a1aa; letter-spacing: .15em; font-size: .8rem; }
  h1 { font-size: clamp(2.5rem, 7vw, 4rem); margin: 1rem 0; }
  label { display: block; margin-top: 2rem; }
  input { width: 100%; padding: .75rem; margin: .5rem 0; color: #fafafa; background: #18181b; border: 1px solid #a1a1aa; border-radius: .4rem; font: inherit; }
  ul { list-style: none; padding: 0; }
  li { padding: 1.2rem 0; border-bottom: 1px solid #3f3f46; }
  button { margin-top: 1rem; padding: .7rem 1rem; color: #fafafa; background: #27272a; border: 1px solid #a1a1aa; border-radius: .4rem; font: inherit; cursor: pointer; }
  button[hidden] { display: none; }
  a { color: #bfdbfe; text-decoration: underline; }
  :focus-visible { outline: 3px solid #fbbf24; outline-offset: 3px; }
</style>
