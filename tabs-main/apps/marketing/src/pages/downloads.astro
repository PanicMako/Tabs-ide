---
import ConceptOneDownload from "../components/download/ConceptOneDownload.astro";
import SiteScripts from "../components/SiteScripts.astro";
import SiteThemeHead from "../components/SiteThemeHead.astro";
import SeoHead from "../components/SeoHead.astro";

import "../styles/concepts.css";
import "../styles/concept-one.css";

const title = "Download Tabs IDE Public Beta for macOS, Windows, or Linux";
const description = "Download the Tabs IDE Public Beta desktop workspace for Apple Silicon and Intel Macs, Windows x64, or Linux AppImage.";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteThemeHead />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={description}
    />
    <title>{title}</title>
    <SeoHead title={title} description={description} path="/downloads" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main">
      <ConceptOneDownload />
    </main>

    <noscript>
      <style>
        [data-concept][hidden] { display: block !important; }
        .concept-rail { display: none; }
      </style>
    </noscript>

    <SiteScripts />
    <script>import "../lib/motion";</script>
  </body>
</html>
