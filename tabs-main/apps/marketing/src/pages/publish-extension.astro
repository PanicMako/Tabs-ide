---
import Layout from "../layouts/ExchangeLayout.astro";
import Icon from "../components/Icon.astro";
import { configuredExchangeOrigin } from "../lib/exchange-url";

const exchange = import.meta.env.DEV && import.meta.env.PUBLIC_TABS_EXCHANGE_PREVIEW === "true" ? null : configuredExchangeOrigin(import.meta.env.PUBLIC_TABS_EXCHANGE_URL);
---

<Layout title="Publish a Tabs Extension" description="Submit a Tabs-native extension package for review." active="publish">
  <section>
    <div class="exchange-hero"><div><p class="exchange-eyebrow"><Icon name="Puzzle" size={16} /> For developers</p><h1>Build your tool.<br /><em>Give it a home.</em></h1><p class="exchange-lead">Bring your workflow into Tabs. Bundle a full-workspace tool, submit it for review, and share it through the Exchange.</p></div><div class="exchange-emblem" aria-hidden="true"><Icon name="Code2" size={56} /></div></div>
    <ol class="exchange-steps" aria-label="Publishing steps">
      <li class="exchange-card"><div class="exchange-step-number">01 / BUILD</div><h2>Make it Tabs-native.</h2><p>Create a <code>tabs-extension.json</code> manifest, bundle your UI, and package a deterministic <code>.tabsext</code> archive. Test it locally in the desktop development build.</p></li>
      <li class="exchange-card"><div class="exchange-step-number">02 / SUBMIT</div><h2>Put your name on it.</h2><p>Sign in with GitHub, create a publisher namespace, and upload your package. Each version stays private while automated checks and manual review take place.</p></li>
      <li class="exchange-card"><div class="exchange-step-number">03 / SHARE</div><h2>Join the workspace.</h2><p>After approval, users can discover and download that exact version. Updates go through the same review process, with permission changes shown before installation.</p></li>
    </ol>
    <div class="exchange-publish-panel"><div><h2>Ready to publish?</h2>
    {exchange ? (
      <p>Manage your namespace, submissions, and releases in the publisher portal.</p>
    ) : (
      <p role="status">Public submissions are not open yet. The package and local development tooling are still experimental.</p>
    )}
    </div>{exchange ? <a class="exchange-button" href={`${exchange}/publisher`}>Open publisher portal <Icon name="ArrowUpRight" size={16} /></a> : <a class="exchange-button secondary" href="https://github.com/mxyxyz9/Tabs-ide" target="_blank" rel="noopener noreferrer">Follow development <Icon name="ArrowUpRight" size={16} /></a>}</div>
    <div class="exchange-note"><Icon name="ShieldCheck" size={18} /><p>Review is not a security guarantee. Disclose data access, external services, and any charges to users. Namespace membership alone does not verify publisher ownership. <a href="/extensions">Explore the Exchange</a></p></div>
  </section>
</Layout>
