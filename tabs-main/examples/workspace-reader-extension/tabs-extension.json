{
  "manifestVersion": 1,
  "publisher": "tabs-example",
  "name": "workspace-reader",
  "version": "0.1.0",
  "displayName": "Workspace Reader",
  "description": "Read a small text file in the current Tabs project with explicit permission.",
  "engines": { "tabs": ">=1.3.0 <2.0.0" },
  "capabilities": ["profile-storage", "workspace-read"],
  "contributes": {
    "tools": [{ "id": "reader", "label": "Reader", "entry": "dist/index.html" }]
  }
}
