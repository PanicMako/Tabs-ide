{
  "manifestVersion": 1,
  "publisher": "tabs-example",
  "name": "calculator",
  "version": "0.2.0",
  "displayName": "Calculator",
  "description": "A full-workspace sample with isolated computation commands.",
  "engines": {
    "tabs": ">=1.3.0 <2.0.0",
    "api": "^1.3.0"
  },
  "capabilities": ["ai-tools"],
  "logic": { "entry": "dist/logic.js" },
  "contributes": {
    "tools": [{ "id": "calculator", "label": "Calculator", "entry": "dist/index.html" }],
    "commands": [
      { "id": "add", "label": "Add", "description": "Add two finite numbers.", "aiCallable": true },
      { "id": "multiply", "label": "Multiply", "description": "Multiply two finite numbers." }
    ]
  }
}
